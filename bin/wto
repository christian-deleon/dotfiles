#!/usr/bin/env bash
# wto — coordinate agent sessions across a project's worktrees
#
# Usage: wto <command> [args]   (run anywhere inside a worktrunk project)
# shellcheck disable=SC2329 # the *_locked functions run through with_lock
set -Eeuo pipefail
shopt -s inherit_errexit nullglob

# OpenCode's npm build runs as opencode.exe on Linux too.
readonly HARNESSES='claude|grok|opencode(\\.exe)?'

die() {
    printf 'wto: %s\n' "$*" >&2
    exit 1
}

usage() {
    cat <<'EOF'
Usage: wto <command> [args]

  ls [--json] [--files]        roster: every worktree with its git state, agent session,
                               and the model and effort wtc saved for it
  here                         print the live orchestrator marker (exit 1 if none)
  here --orchestrator          mark the calling pane as this project's orchestrator
  here --clear [--force]       remove the orchestrator marker
  dir                          print this project's state directory
  profile [--path]             print the project profile (exit 1 if there is none)
  send <branch|--main|--all> [--relay] [--force] [-f file | message...]
                               deliver a message to another session, with the origin header
  header [--relay]             print the origin header for this session

  claim define [<resource>...]  set (or print) the names claims may use
  claim take <resource>... [--note text]   take all of them, or queue (exit 2)
  claim free [<resource>...|--all] [--force]   free and hand over to the next waiter
  claim check <resource>...    exit 0 only if this worktree holds all of them
  claim wait [--timeout secs]  wait for this worktree's queued request (default 60s)
  claim status [--json]        holders and the queue
  claim bump <branch>          move that branch's waiting requests to the front
  claim gc                     drop claims of removed worktrees, then hand over
  close <branch>               close a finished session: kill its window, remove its worktree

  new [-m model] [-e effort] [-p text | -f file] [--switch] <branch> [base]
                               create a worktree and open its agent window (stays put
                               unless --switch); -m/-e are saved for later launches
  open [-p text | -f file] [--switch] [<branch>]
                               open a worktree's window, continuing its conversation;
                               no branch: the only worktree, or a picker
  open --all [--switch]        open every worktree; main always starts fresh
  layout [--k9s] [-t tool] [-p text | -f file | prompt...]
                               lay out the calling pane: agent, editor, shell

Agent commands come from $AI_TOOL / $AI_TOOL_RESUME (read from ~/.localrc
when unset); the shortcuts cl, cca, gr, gra, oc and oca mean what .aliases says.

Exit codes for send to one target: 4 no session, 5 exited, 6 blocked on a
question or state unknown (--force sends anyway), 7 launched too recently.
claim exits 75 when the claim lock stays busy for 5 seconds.

Run inside a worktrunk project. Agent sessions are found by the tmux pane
options that tav sets (@ai_tool, @ai_wt, @ai_state).
EOF
}

require() {
    local cmd
    for cmd in "$@"; do
        command -v "$cmd" >/dev/null 2>&1 || die "$cmd is required"
    done
}

state_dir() {
    local common
    common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) \
        || die "not inside a git repository"
    mkdir -p -- "$common/orchestrate"
    printf '%s\n' "$common/orchestrate"
}

# {"default": <default branch>, "items": [<worktree>...]} from wt list.
wt_list() {
    local raw
    raw=$(wt list --format json 2>/dev/null) || die "wt list failed (run inside a worktrunk project)"
    jq -c '(if type == "array" then {items: .} else . end)
        | (.items // [] | map(select((.worktree.path // "") != ""))) as $items
        | {default: (.repo.default_branch
                     // ($items | map(select(.worktree.main == true)) | first | .branch)),
           items: $items}' <<<"$raw"
}

# Panes that run, or were tagged for, an agent session. Untagged panes (opened
# before tav tagged them) are matched by a harness process under the pane.
panes_json() {
    local fmt pane_pids
    if ! tmux info >/dev/null 2>&1; then
        printf '[]\n'
        return
    fi
    fmt='#{pane_id}'$'\t''#{pane_pid}'$'\t''#{session_name}:#{window_name}'$'\t''#{@ai_tool}'
    fmt+=$'\t''#{@ai_wt}'$'\t''#{@ai_state}'$'\t''#{@ai_state_at}'$'\t''#{pane_current_path}'
    fmt+=$'\t''#{@ai_session}'
    pane_pids=$(tmux list-panes -a -F '#{pane_pid}' | paste -sd, -)
    jq -n -c --rawfile panes <(tmux list-panes -a -F "$fmt") \
        --rawfile procs <(harness_procs "$pane_pids") '
        ($procs | split("\n") | map(select(length > 0) | split("\t"))
            | map({key: .[0], value: {tool: .[1], args: .[2]}}) | from_entries) as $by_pid
        | $panes | split("\n") | map(select(length > 0) | split("\t")
            | {pane: .[0], pid: .[1], window: .[2], tag_tool: .[3], tag_wt: .[4],
               state: .[5], state_at: .[6], cwd: .[7], oc_session: (.[8] // "")}
            | . + {proc: $by_pid[.pid]})
        | map(select(.tag_tool != "" or .proc != null))'
}

# "<pane pid>\t<harness>\t<args>" for each harness process under a pane.
harness_procs() {
    # ucomm, not comm: BSD ps prints comm as the full executable path.
    ps -e -o pid=,ppid=,ucomm=,args= | awk -v panes="$1" -v re="^($HARNESSES)$" '
        BEGIN { n = split(panes, p, ","); for (i = 1; i <= n; i++) pane[p[i]] = 1 }
        {
            pid = $1; ppid[pid] = $2; comm[pid] = $3; sub(/.*\//, "", comm[pid])
            $1 = $2 = $3 = ""; sub(/^ +/, ""); args[pid] = $0
        }
        END {
            for (pid in comm) {
                if (comm[pid] !~ re) continue
                cur = pid
                for (depth = 0; depth < 8 && cur != "" && cur != "1"; depth++) {
                    if (cur in pane) { name = comm[pid]; sub(/\.exe$/, "", name); print cur "\t" name "\t" args[pid]; break }
                    cur = ppid[cur]
                }
            }
        }'
}

# {<worktree path>: {model, effort}} from the ai-launch file that `wtc
# --model/--effort` writes into each worktree's git dir.
launch_json() {
    local path saved model effort out=()
    while IFS= read -r path; do
        saved=$(launch_settings "$path") || continue
        IFS='|' read -r model effort <<<"$saved"
        out+=("$(jq -n -c --arg p "$path" --arg m "$model" --arg e "$effort" \
            '{($p): {model: (if $m == "" then null else $m end), effort: (if $e == "" then null else $e end)}}')")
    done < <(jq -r '.items[].worktree.path' <<<"$1")
    printf '%s\n' "${out[@]}" | jq -s -c 'add // {}'
}

roster_json() {
    local list panes launch now claims='{}' dir orch_pane=""
    # Explicit returns: callers use `|| ...`, which turns off set -e in here.
    list=$(wt_list) || return 1
    panes=$(panes_json) || return 1
    launch=$(launch_json "$list") || return 1
    now=$(date +%s)
    dir=$(state_dir)
    [[ -s $dir/claims/state.json ]] && claims=$(<"$dir/claims/state.json")
    marker_valid "$dir/orchestrator.json" && orch_pane=$(jq -r '.pane // ""' "$dir/orchestrator.json")
    jq -n -c --argjson list "$list" --argjson panes "$panes" --argjson now "$now" \
        --argjson claims "$claims" --argjson launch "$launch" --arg orch "$orch_pane" '
        def under($p): . == $p or startswith($p + "/");
        def auto($args):
            if $args == null then null
            else ($args | test("bypassPermissions|--dangerously-skip-permissions|--always-approve|--auto(\\s|$)"))
            end;
        $list.default as $default
        | $list.items | map(
            .worktree.path as $path
            # A live harness beats a pane left over from an earlier one, and in
            # main the orchestrator pane beats other agent panes.
            | (([$panes[] | select(.tag_wt == $path)]
                + [$panes[] | select(.tag_wt == "" and (.cwd | under($path)))])
               | sort_by([(if .proc != null and .state != "exited" then 0 else 1 end),
                          (if .pane == $orch then 0 else 1 end)])
               | first) as $pane
          | {
              branch: (.branch // null),
              path: .worktree.path,
              main: (.worktree.main == true),
              detached: (.worktree.detached == true),
              # wt reports no changes object when its status check timed out.
              dirty: (if .worktree.changes == null then null
                      else [.worktree.changes | .staged, .modified, .untracked, .renamed, .deleted] | any end),
              conflicted_files: (.worktree.changes.conflicted == true),
              ahead: (.default_branch.ahead // null),
              behind: (.default_branch.behind // null),
              rebase_conflicts: (.default_branch.merge_conflicts // false),
              integrated: (.default_branch.integration.reason // null),
              state: (.display.state // null),
              operation: (.worktree.operation // .operation // null),
              default_branch: $default,
              claims: [($claims.holders // {}) | to_entries[] | select(.value.wt == $path) | .key],
              unacked_grants: [($claims.holders // {}) | to_entries[]
                  | select(.value.wt == $path and .value.granted_at != null and .value.acked_at == null) | .key],
              queued: [($claims.queue // [])[] | select(.wt == $path) | .res[]],
              launch: ($launch[$path] // null),
              session: (if $pane == null then null else {
                  pane: $pane.pane,
                  window: $pane.window,
                  tool: (if $pane.tag_tool != "" then $pane.tag_tool else $pane.proc.tool end),
                  state: (if $pane.state != "" then $pane.state
                          elif $pane.proc != null then "unknown" else "exited" end),
                  state_age: (if ($pane.state_at | test("^[0-9]+$")) then $now - ($pane.state_at | tonumber) else null end),
                  auto_approve: auto($pane.proc.args),
                  running: ($pane.proc != null),
                  opencode_session: (if $pane.oc_session != "" then $pane.oc_session else null end),
                  tagged: ($pane.tag_tool != "")
              } end)
            })'
}

add_conflict_files() {
    local roster=$1 default branch merged rc files out=()
    default=$(jq -r '[.[].default_branch | select(. != null)][0] // empty' <<<"$roster")
    [[ -n $default ]] || { printf '%s\n' "$roster"; return; }
    while IFS= read -r branch; do
        [[ -n $branch ]] || continue
        # Exit 1 means "conflicts", which is the case this runs for.
        rc=0
        merged=$(git merge-tree --write-tree --name-only --no-messages "$default" "$branch" 2>/dev/null) || rc=$?
        if ((rc == 0 || rc == 1)); then
            files=$(tail -n +2 <<<"$merged" | jq -R -s -c 'split("\n") | map(select(length > 0)) | unique')
        else
            files=null
        fi
        out+=("$(jq -n -c --arg b "$branch" --argjson f "$files" '{($b): $f}')")
    done < <(jq -r '.[] | select(.rebase_conflicts and .branch != null) | .branch' <<<"$roster")
    jq -c --argjson files "$(printf '%s\n' "${out[@]}" | jq -s -c 'add // {}')" \
        'map(. + {conflict_files: ($files[.branch] // null)})' <<<"$roster"
}

cmd_ls() {
    local json=0 files=0 roster
    while (($#)); do
        case $1 in
            --json) json=1 ;;
            --files) files=1 ;;
            -h | --help) usage; return ;;
            *) die "ls: unknown option '$1'" ;;
        esac
        shift
    done
    roster=$(roster_json)
    ((files)) && roster=$(add_conflict_files "$roster")
    if ((json)); then
        jq . <<<"$roster"
        return
    fi
    jq -r '
        ["BRANCH", "SESSION", "TOOL", "MODEL", "AHEAD", "BEHIND", "DIRTY", "REBASE", "CLAIMS", "WINDOW"],
        (.[] | [
            (.branch // "(detached)") + (if .main then " *" else "" end),
            (if .session == null then "-"
             else .session.state + (if .session.state_age != null then " " + (.session.state_age / 60 | floor | tostring) + "m" else "" end)
             end),
            (.session.tool // "-"),
            (if .launch == null then "-"
             else [(.launch.model // "default"), (.launch.effort // empty)] | join(" ") end),
            (.ahead // "-" | tostring), (.behind // "-" | tostring),
            (if .dirty == null then "?" elif .dirty then "yes" else "-" end),
            (if .operation != null then .operation
             elif .rebase_conflicts then "conflicts"
             elif (.behind // 0) > 0 then "clean" else "-" end),
            ([(.claims | join(",") | select(. != "")),
              (if (.queued | length) > 0 then "waiting: " + (.queued | join(",")) else empty end)]
             | if length == 0 then "-" else join(" ") end),
            (.session.window // "-")
        ])
        | @tsv' <<<"$roster" | column -t -s $'\t'
}

marker_valid() {
    local marker=$1 pane tmux_pid live_pid live_pane state
    [[ -f $marker ]] || return 1
    pane=$(jq -r '.pane // empty' "$marker" 2>/dev/null) || return 1
    tmux_pid=$(jq -r '.tmux_pid // empty' "$marker" 2>/dev/null) || return 1
    [[ -n $pane && -n $tmux_pid ]] || return 1
    live_pid=$(tmux display-message -p '#{pid}' 2>/dev/null) || return 1
    [[ $live_pid == "$tmux_pid" ]] || return 1
    live_pane=$(tmux display-message -p -t "$pane" '#{pane_id}' 2>/dev/null) || return 1
    [[ $live_pane == "$pane" ]] || return 1
    state=$(tmux show-options -pqv -t "$pane" @ai_state 2>/dev/null) || state=""
    [[ $state != exited ]]
}

cmd_here() {
    local mode=show force=0 dir marker top main_path
    while (($#)); do
        case $1 in
            --orchestrator) mode='write' ;;
            --clear) mode=clear ;;
            --force) force=1 ;;
            -h | --help) usage; return ;;
            *) die "here: unknown option '$1'" ;;
        esac
        shift
    done
    dir=$(state_dir)
    marker=$dir/orchestrator.json

    case $mode in
        show)
            marker_valid "$marker" || return 1
            jq . "$marker"
            ;;
        write)
            [[ -n ${TMUX_PANE-} ]] || die "here: not inside tmux (TMUX_PANE unset)"
            top=$(git rev-parse --show-toplevel)
            main_path=$(wt_list | jq -r '[.items[] | select(.worktree.main == true)][0].worktree.path // empty')
            [[ $top == "$main_path" ]] || die "here: the orchestrator runs in the main worktree ($main_path)"
            if marker_valid "$marker" && [[ $(jq -r .pane "$marker") != "$TMUX_PANE" ]]; then
                printf 'wto: an orchestrator is already running in %s\n' "$(jq -r .window "$marker")" >&2
                return 3
            fi
            jq -n \
                --arg pane "$TMUX_PANE" \
                --arg tmux_pid "$(tmux display-message -p '#{pid}')" \
                --arg window "$(tmux display-message -p -t "$TMUX_PANE" '#{session_name}:#{window_name}')" \
                --arg tool "$(tmux show-options -pqv -t "$TMUX_PANE" @ai_tool)" \
                --arg branch "$(git branch --show-current)" \
                --arg path "$top" \
                --argjson started "$(date +%s)" \
                '{pane: $pane, tmux_pid: $tmux_pid, window: $window, tool: $tool,
                  branch: $branch, path: $path, started: $started}' >"$marker.tmp"
            mv -- "$marker.tmp" "$marker"
            jq . "$marker"
            ;;
        clear)
            [[ -f $marker ]] || return 0
            if ((!force)) && marker_valid "$marker" && [[ $(jq -r .pane "$marker") != "${TMUX_PANE-}" ]]; then
                die "here: the live orchestrator is another pane ($(jq -r .window "$marker")); use --force"
            fi
            rm -f -- "$marker"
            ;;
    esac
}

caller_header() {
    local relay=$1 common project branch role=session kind='agent notice' marker
    common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) \
        || die "not inside a git repository"
    project=$(basename "$(dirname "$common")")
    branch=$(git branch --show-current 2>/dev/null) || branch=""
    [[ -n $branch ]] || branch=$(basename "$(git rev-parse --show-toplevel)")
    marker=$common/orchestrate/orchestrator.json
    if [[ -n ${TMUX_PANE-} ]] && marker_valid "$marker" && [[ $(jq -r .pane "$marker") == "$TMUX_PANE" ]]; then
        role=orchestrator
    fi
    ((relay)) && kind="relaying the user's words"
    printf '[session message · from %s/%s (%s) · %s]\n' "$project" "$branch" "$role" "$kind"
}

cmd_header() {
    local relay=0
    while (($#)); do
        case $1 in
            --relay) relay=1 ;;
            -h | --help) usage; return ;;
            *) die "header: unknown option '$1'" ;;
        esac
        shift
    done
    caller_header "$relay"
}

# Deliver one message to one roster entry. Returns the documented exit code.
deliver() {
    local entry=$1 body_file=$2 force=$3 branch pane tool state age running oc_session path buf
    branch=$(jq -r '.branch // "(detached)"' <<<"$entry")
    if [[ $(jq -r '.session == null' <<<"$entry") == true ]]; then
        printf '%s: no session\n' "$branch"
        return 4
    fi
    # \x1f, not a tab: read collapses runs of whitespace separators, which
    # would shift every field after an empty one.
    IFS=$'\x1f' read -r pane tool state age running oc_session path < <(jq -r '[.session.pane, .session.tool,
        .session.state, (.session.state_age // -1), .session.running, (.session.opencode_session // ""), .path]
        | map(tostring) | join("\u001f")' <<<"$entry")
    if [[ $pane == "${TMUX_PANE-}" ]]; then
        printf '%s: is this session, skipped\n' "$branch"
        return 4
    fi
    if [[ $state == exited || $running != true ]]; then
        printf '%s: session has exited\n' "$branch"
        return 5
    fi
    if [[ $state == blocked ]] || { [[ $state == unknown ]] && ((!force)); }; then
        printf '%s: %s; not sent%s\n' "$branch" \
            "$([[ $state == blocked ]] && echo 'waiting on a question' || echo 'state unknown (session predates pane tags)')" \
            "$([[ $state == unknown ]] && echo '; close its window and run wta to reopen it tagged, or pass --force')"
        return 6
    fi
    if [[ $state == starting ]] && ((age >= 0 && age < 15)); then
        printf '%s: launched %ss ago; retry shortly\n' "$branch" "$age"
        return 7
    fi

    if [[ $tool == opencode && -n $oc_session ]]; then
        (cd -- "$path" && opencode api session.prompt --param "sessionID=$oc_session" \
            --data "$(jq -n -c --rawfile text "$body_file" '{text: $text, delivery: "queue"}')") >/dev/null \
            || { printf '%s: opencode delivery failed\n' "$branch"; return 1; }
    else
        buf="wto-$$-${RANDOM}"
        tmux load-buffer -b "$buf" "$body_file"
        tmux paste-buffer -d -p -b "$buf" -t "$pane"
        sleep 0.8
        tmux send-keys -t "$pane" Enter
    fi
    printf '%s: sent (%s, %s)\n' "$branch" "$tool" "$state"
}

cmd_send() {
    local target="" relay=0 force=0 file="" roster body_file body rc=0 code entry
    local -a words=() entries=()
    while (($#)); do
        case $1 in
            --main | --all) target=$1 ;;
            --relay) relay=1 ;;
            --force) force=1 ;;
            -f) file=${2:?send: -f needs a file}; shift ;;
            -h | --help) usage; return ;;
            --) shift; words+=("$@"); break ;;
            -*) die "send: unknown option '$1'" ;;
            *) if [[ -z $target ]]; then target=$1; else words+=("$1"); fi ;;
        esac
        shift
    done
    [[ -n $target ]] || die "send: name a branch, --main or --all"

    body_file=$(mktemp)
    # shellcheck disable=SC2064  # expand now: body_file is local, the trap runs at exit
    trap "rm -f -- $(printf '%q' "$body_file")" EXIT
    caller_header "$relay" >"$body_file"
    if [[ -n $file ]]; then
        cat -- "$file" >>"$body_file"
    elif ((${#words[@]})); then
        printf '%s\n' "${words[*]}" >>"$body_file"
    elif [[ ! -t 0 ]]; then
        cat >>"$body_file"
    else
        die "send: no message (pass words, -f file, or stdin)"
    fi
    # Pasted text must not end in a newline, or a TUI may submit early.
    body=$(<"$body_file")
    printf '%s' "$body" >"$body_file"

    roster=$(roster_json)
    case $target in
        --main) mapfile -t entries < <(jq -c '.[] | select(.main)' <<<"$roster") ;;
        --all) mapfile -t entries < <(jq -c --arg self "$(git rev-parse --show-toplevel)" \
            '.[] | select(.path != $self and .session != null)' <<<"$roster") ;;
        *) mapfile -t entries < <(jq -c --arg b "$target" '.[] | select(.branch == $b)' <<<"$roster") ;;
    esac
    ((${#entries[@]})) || die "send: no worktree for '$target'"

    for entry in "${entries[@]}"; do
        code=0
        deliver "$entry" "$body_file" "$force" || code=$?
        ((code == 0)) || rc=$code
    done
    return "$rc"
}

# ── claims ────────────────────────────────────────────────────────────────────
# One JSON ledger per project, changed only under a lock file that is never
# replaced. A claim belongs to a worktree path (HEAD is detached mid-rebase, so
# a branch key would break), not to a process, so it survives restarts.

claims_dir() {
    local d
    d=$(state_dir)/claims
    mkdir -p -- "$d"
    printf '%s\n' "$d"
}

self_wt() { git rev-parse --show-toplevel; }

self_label() {
    local b
    b=$(git branch --show-current 2>/dev/null) || b=""
    [[ -n $b ]] || b=$(basename "$(self_wt)")
    printf '%s\n' "$b"
}

# Run "$@" in a subshell holding the claims lock: flock(1) where it exists,
# else perl's flock() on the same fd (macOS ships perl but not flock). Either
# way it is a flock(2) lock on the subshell's fd 9, held until the subshell
# exits and released by the kernel if it dies.
with_lock() {
    local lock
    lock=$(claims_dir)/lock
    (
        if command -v flock >/dev/null 2>&1; then
            flock -w 5 9 || exit 75
        elif command -v perl >/dev/null 2>&1; then
            # shellcheck disable=SC2016  # perl program, not shell
            perl -MFcntl=:flock -e 'open(my $f, ">&=", 9) or exit 1;
                for (1 .. 50) { exit 0 if flock($f, LOCK_EX | LOCK_NB); select(undef, undef, undef, 0.1) }
                exit 75' || exit $?
        else
            die "claim: needs flock or perl to lock the claims ledger"
        fi
        "$@"
    ) 9>>"$lock"
}

claims_read() {
    local f
    f=$(claims_dir)/state.json
    if [[ -s $f ]]; then cat -- "$f"; else printf '{"holders":{},"queue":[],"seq":0,"log":[]}\n'; fi
}

# A failed jq upstream hands this nothing; writing that would erase every claim.
claims_write() {
    local f data
    f=$(claims_dir)/state.json
    data=$(cat)
    jq -e 'type == "object" and has("holders") and has("queue")' <<<"$data" >/dev/null 2>&1 \
        || { printf 'wto: claims ledger update failed; left unchanged\n' >&2; return 1; }
    printf '%s\n' "$data" >"$f.tmp"
    mv -- "$f.tmp" "$f"
}

registry_check() {
    local reg name
    reg=$(claims_dir)/resources
    [[ -s $reg ]] || return 0
    for name in "$@"; do
        grep -Fxq -- "$name" "$reg" || die "claim: unknown resource '$name' (known: $(paste -sd' ' "$reg"))"
    done
}

# JSON array of worktree paths that still exist, read inside the lock so a
# worktree created a moment ago keeps its claim. A failed or empty listing
# would read as "every worktree is gone", so it fails instead.
existing_wts() {
    local list exist
    list=$(git worktree list --porcelain) || list=""
    exist=$(awk '$1 == "worktree" { print substr($0, 10) }' <<<"$list" \
        | jq -R -s -c 'split("\n") | map(select(length > 0))')
    if [[ $(jq -r 'length > 0' <<<"$exist" 2>/dev/null) != true ]]; then
        printf 'wto: cannot list worktrees; claims left unchanged\n' >&2
        return 1
    fi
    printf '%s\n' "$exist"
}

# JSON array of worktree paths with a live session, plus any paths given.
live_wts() {
    local roster
    roster=$(roster_json) || return 1
    jq -c --args '[.[] | select(.session.running == true and .session.state != "exited") | .path]
        + $ARGS.positional | unique' "$@" <<<"$roster"
}

# Drop entries for removed worktrees, then walk the queue in order. A waiter is
# granted when what it still needs is free and no earlier live waiter asked for
# any of it, so a multi-resource request cannot starve. The one exception: an
# earlier waiter that wants something this waiter already holds cannot proceed
# before this one frees it, so its reservation is not honoured (that would
# deadlock both). Waiters without a live session keep their place but are
# skipped and reserve nothing.
# shellcheck disable=SC2016  # jq program, not shell
readonly GRANT_JQ='
    . as $st
    | ($st.holders // {} | with_entries(select(.value.wt as $w | $exist | index($w)))) as $h
    | ($st.queue // [] | map(select(.wt as $w | $exist | index($w)))) as $q
    | reduce $q[] as $e ({holders: $h, queue: [], blocked: [], grants: []};
        . as $acc
        | [$acc.holders | to_entries[] | select(.value.wt == $e.wt) | .key] as $mine
        | ($e.res - $mine) as $need
        | if ($need | length) == 0 then .
        elif ($live | index($e.wt)) == null then .queue += [$e]
        elif ([$need[] | $acc.holders[.] == null] | all)
            and ([$acc.blocked[] | select(.wt != $e.wt and ([.res[] | IN($need[])] | any))
                  | [.res[] | IN($mine[])] | any] | all)
        then .holders += ($need | map({key: ., value: {wt: $e.wt, branch: $e.branch, since: $now,
                 note: $e.note, granted_at: $now, acked_at: null}}) | from_entries)
            | .grants += [{branch: $e.branch, wt: $e.wt, res: $need}]
        else .queue += [$e] | .blocked += [{wt: $e.wt, res: $e.res}]
        end)
    | {state: ($st + {holders: .holders, queue: .queue}), grants: .grants}'

report_grants() {
    jq -r '.grants[] | "granted \(.res | join(",")) to \(.branch) — tell that session it is its turn"'
}

claim_take_locked() {
    local wt=$1 label=$2 note=$3 live=$4 exist now st out
    shift 4
    exist=$(existing_wts) || return 1
    now=$(date +%s)
    st=$(claims_read)
    out=$(jq -c --arg wt "$wt" --arg label "$label" --arg note "$note" --argjson now "$now" \
        --argjson live "$live" --argjson exist "$exist" --args '
        ($ARGS.positional | unique) as $res
        | . as $st
        # What this worktree neither holds nor already waits for joins the back
        # of the queue; growing an earlier request would jump the queue.
        | ([$st.holders | to_entries[] | select(.value.wt == $wt) | .key]
           + [$st.queue[]? | select(.wt == $wt) | .res[]]) as $have
        | ($res - $have) as $new
        | if ($new | length) == 0 then .
          else .seq += 1 | .queue += [{id: .seq, wt: $wt, branch: $label, res: $new, note: $note, at: $now}]
          end
        | '"$GRANT_JQ"'
        | .state.holders |= with_entries(if .value.wt == $wt and .value.acked_at == null and .value.granted_at == $now
              then .value.acked_at = $now else . end)
        | . + {mine: ([.state.holders | to_entries[] | select(.value.wt == $wt) | .key]),
               position: ([.state.queue[] | select(.wt as $w | $live | index($w))] | map(.wt) | index($wt))}
        ' "$@" <<<"$st")
    [[ -n $out ]] || return 1
    jq -c '.state' <<<"$out" | claims_write || return 1
    jq -r --args '
        ($ARGS.positional) as $want
        | if (.mine as $m | [$want[] | IN($m[])] | all) then "held: \($want | join(","))"
          else "queued at position \((.position // 0) + 1) for \($want | join(","))"
            + (if (.mine | length) > 0 then "\nnote: still holding \(.mine | join(",")) while waiting; a session waiting for those cannot proceed, so free what you can or take everything in one call" else "" end)
          end' "$@" <<<"$out"
    jq -r --arg wt "$wt" '.grants[] | select(.wt != $wt) | "granted \(.res | join(",")) to \(.branch) — tell that session it is its turn"' <<<"$out"
    [[ $(jq -r --args '.mine as $m | [$ARGS.positional[] | IN($m[])] | all' "$@" <<<"$out") == true ]] || return 2
}

claim_free_locked() {
    local wt=$1 label=$2 all=$3 force=$4 live=$5 exist now st out
    shift 5
    exist=$(existing_wts) || return 1
    now=$(date +%s)
    st=$(claims_read)
    out=$(jq -c --arg wt "$wt" --arg label "$label" --argjson all "$all" --argjson force "$force" \
        --argjson now "$now" --argjson live "$live" --argjson exist "$exist" --args '
        ($all == 1) as $all | ($force == 1) as $force
        | ($ARGS.positional) as $res
        | (if $all then [.holders | to_entries[] | select(.value.wt == $wt) | .key] else $res end) as $targets
        | . as $st
        | ([$targets[] | select($st.holders[.] != null and $st.holders[.].wt != $wt)]) as $others
        | if ($others | length) > 0 and ($force | not) then {error: "held by another worktree: \($others | join(",")) (use --force)"}
          else
            .log = ((.log // []) + [$others[] | {at: $now, forced_by: $label, res: ., from: $st.holders[.].branch}] | .[-50:])
            | .holders |= with_entries(select(.key as $k | $targets | index($k) | not))
            | (if $all then .queue |= map(select(.wt != $wt)) else . end)
            | '"$GRANT_JQ"'
          end' "$@" <<<"$st")
    [[ -n $out ]] || return 1
    if [[ $(jq -r '.error // empty' <<<"$out") ]]; then
        die "claim free: $(jq -r .error <<<"$out")"
    fi
    jq -c '.state' <<<"$out" | claims_write || return 1
    report_grants <<<"$out"
}

claim_gc_locked() {
    local live=$1 exist now out
    exist=$(existing_wts) || return 1
    now=$(date +%s)
    out=$(claims_read | jq -c --argjson now "$now" --argjson live "$live" --argjson exist "$exist" "$GRANT_JQ")
    [[ -n $out ]] || return 1
    jq -c '.state' <<<"$out" | claims_write || return 1
    report_grants <<<"$out"
}

claim_bump_locked() {
    local branch=$1 live=$2 exist now out
    exist=$(existing_wts) || return 1
    now=$(date +%s)
    out=$(claims_read | jq -c --arg b "$branch" --argjson now "$now" --argjson live "$live" --argjson exist "$exist" '
        if any(.queue[]?; .branch == $b) | not then {error: "\($b) is not waiting for anything"}
        else .queue = ([.queue[] | select(.branch == $b)] + [.queue[] | select(.branch != $b)]) | '"$GRANT_JQ"'
        end')
    [[ -n $out ]] || return 1
    if [[ $(jq -r '.error // empty' <<<"$out") ]]; then
        die "claim bump: $(jq -r .error <<<"$out")"
    fi
    jq -c '.state' <<<"$out" | claims_write || return 1
    report_grants <<<"$out"
}

claim_ack_locked() {
    local wt=$1 now
    now=$(date +%s)
    claims_read | jq -c --arg wt "$wt" --argjson now "$now" \
        '.holders |= with_entries(if .value.wt == $wt and .value.acked_at == null then .value.acked_at = $now else . end)' \
        | claims_write
}

claims_status() {
    local json=$1 st
    st=$(claims_read)
    if ((json)); then
        jq . <<<"$st"
        return
    fi
    jq -r '
        (if (.holders | length) == 0 then "no claims held"
         else (.holders | to_entries[] | "\(.key)\theld by \(.value.branch)\t\(if .value.acked_at == null then "granted, not yet acknowledged" else "in use" end)\t\(.value.note // "")") end),
        (.queue | to_entries[] | "\(.value.res | join(","))\twaiting #\(.key + 1): \(.value.branch)\tqueued\t\(.value.note // "")")
    ' <<<"$st" | column -t -s $'\t'
}

cmd_claim() {
    local sub=${1:-status} wt label live note="" all=0 force=0 json=0 timeout=60 deadline rc
    (($#)) && shift
    local -a names=()
    while (($#)); do
        case $1 in
            --note) note=${2:?claim: --note needs text}; shift ;;
            --all) all=1 ;;
            --force) force=1 ;;
            --json) json=1 ;;
            --timeout) timeout=${2:?claim: --timeout needs seconds}; shift ;;
            -h | --help) usage; return ;;
            -*) die "claim: unknown option '$1'" ;;
            *) names+=("$1") ;;
        esac
        shift
    done
    wt=$(self_wt)
    label=$(self_label)
    case $sub in
        take | free | bump | gc) live=$(live_wts "$wt") || die "claim: cannot read the session roster; claims left unchanged" ;;
    esac

    case $sub in
        define)
            if ((${#names[@]} == 0)); then
                [[ -s $(claims_dir)/resources ]] && cat -- "$(claims_dir)/resources"
                return 0
            fi
            printf '%s\n' "${names[@]}" | sort -u >"$(claims_dir)/resources"
            ;;
        take)
            ((${#names[@]})) || die "claim take: name at least one resource"
            registry_check "${names[@]}"
            with_lock claim_take_locked "$wt" "$label" "$note" "$live" "${names[@]}"
            ;;
        free)
            ((all || ${#names[@]})) || die "claim free: name resources or pass --all"
            with_lock claim_free_locked "$wt" "$label" "$all" "$force" "$live" "${names[@]}"
            ;;
        check)
            ((${#names[@]})) || die "claim check: name at least one resource"
            rc=$(claims_read | jq -r --arg wt "$wt" --args '
                [$ARGS.positional[] as $r | .holders[$r].wt == $wt] | all' "${names[@]}")
            if [[ $rc == true ]]; then
                with_lock claim_ack_locked "$wt" 2>/dev/null || true
                return 0
            fi
            claims_read | jq -r --arg wt "$wt" --args '$ARGS.positional[] as $r
                | if .holders[$r] == null then "\($r): free (take it first)"
                  elif .holders[$r].wt != $wt then "\($r): held by \(.holders[$r].branch)"
                  else empty end' "${names[@]}" >&2
            return 1
            ;;
        wait)
            if [[ $(claims_read | jq -r --arg wt "$wt" 'any(.queue[]?; .wt == $wt)') != true ]]; then
                printf 'not waiting for anything\n'
                return 1
            fi
            claims_read | jq -r --arg wt "$wt" '.queue | to_entries[] | select(.value.wt == $wt)
                | "waiting #\(.key + 1) for \(.value.res | join(","))"'
            deadline=$((SECONDS + timeout))
            while ((SECONDS < deadline)); do
                # Hand over on our own behalf too: a waiter with no agent
                # session is skipped by everyone else's grant pass.
                if live=$(live_wts "$wt" 2>/dev/null); then
                    with_lock claim_gc_locked "$live" >/dev/null 2>&1 || true
                fi
                if [[ $(claims_read | jq -r --arg wt "$wt" 'any(.queue[]?; .wt == $wt)') != true ]]; then
                    with_lock claim_ack_locked "$wt" 2>/dev/null || true
                    printf 'granted\n'
                    return 0
                fi
                sleep 2
            done
            printf 'still waiting\n'
            return 2
            ;;
        status) claims_status "$json" ;;
        bump)
            ((${#names[@]} == 1)) || die "claim bump: name one branch"
            with_lock claim_bump_locked "${names[0]}" "$live"
            ;;
        gc) with_lock claim_gc_locked "$live" ;;
        *) die "claim: unknown subcommand '$sub'" ;;
    esac
}

# ── profile ───────────────────────────────────────────────────────────────────
# The project profile /onboard writes: .agents/profile.md in the repo, or
# profile.md beside the overlay AGENTS.md that `dot agent link` symlinks in.
# Kept out of AGENTS.md so sessions load it only when a skill needs it.

profile_path() {
    local top target
    top=$(git rev-parse --show-toplevel 2>/dev/null) || die "not inside a git repository"
    if [[ -f $top/.agents/profile.md ]]; then
        printf '%s\n' "$top/.agents/profile.md"
        return 0
    fi
    if [[ -L $top/AGENTS.md ]]; then
        target=$(readlink -f -- "$top/AGENTS.md") || return 1
        [[ -f ${target%/*}/profile.md ]] && { printf '%s\n' "${target%/*}/profile.md"; return 0; }
    fi
    return 1
}

# A profile still kept as a section of AGENTS.md, from before it had a file.
legacy_profile() {
    local top section
    top=$(git rev-parse --show-toplevel 2>/dev/null) || return 1
    [[ -f $top/AGENTS.md ]] || return 1
    section=$(awk '/^## Project profile[[:space:]]*$/ { on = 1; print; next }
        on && /^## / { exit }
        on { print }' "$top/AGENTS.md")
    [[ -n $section ]] || return 1
    printf '%s\n' "$section"
}

cmd_profile() {
    local path
    case ${1:-} in
        --path) profile_path || exit 1 ;;
        '')
            if path=$(profile_path); then
                cat -- "$path"
            elif legacy_profile; then
                printf 'wto: this profile is a section of AGENTS.md; /onboard moves it into its own file\n' >&2
            else
                exit 1
            fi
            ;;
        -h | --help) usage ;;
        *) die "profile: unknown option '$1'" ;;
    esac
}

# ── launch: worktree windows and the agent layout ─────────────────────────────
# wtc, wta, wtaa, tav and tavk in functions.d are thin wrappers over new, open
# and layout, so agents and people run the same code.

WTO_HOME=$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)
readonly WTO_HOME
# Holds a new window until its agent pane is respawned; an interactive shell
# here would probe the terminal and leak replies into the agent's input.
readonly PLACEHOLDER='sleep 600'

# Fill AI_TOOL / AI_TOOL_RESUME from ~/.localrc, where `dot ai-tool` writes
# them, for shells that never sourced it.
load_ai_tool() {
    local line value
    if [[ -z ${AI_TOOL:-} || -z ${AI_TOOL_RESUME:-} ]] && [[ -f $HOME/.localrc ]]; then
        while IFS= read -r line; do
            value=${line#*=}
            value=${value#\"}
            value=${value%\"}
            case $line in
                'export AI_TOOL='*) AI_TOOL=${AI_TOOL:-$value} ;;
                'export AI_TOOL_RESUME='*) AI_TOOL_RESUME=${AI_TOOL_RESUME:-$value} ;;
            esac
        done <"$HOME/.localrc"
    fi
    [[ -n ${AI_TOOL:-} && -n ${AI_TOOL_RESUME:-} ]] \
        || die "AI_TOOL / AI_TOOL_RESUME unset; run dot ai-tool"
}

# The harness shortcuts, as .aliases defines them for people. Launches run
# outside an interactive shell, so aliases would not expand there.
tool_command() {
    local first=${1%% *} rest=""
    [[ $1 == *' '* ]] && rest=" ${1#* }"
    case $first in
        cl) first=claude ;;
        cca) first='claude --permission-mode bypassPermissions' ;;
        gr) first='grok --trust' ;;
        gra) first='grok --always-approve --trust' ;;
        oc) first=opencode ;;
        oca) first='opencode --auto' ;;
    esac
    printf '%s%s\n' "$first" "$rest"
}

# Worktree windows launch without permission prompts, or an unattended pane
# would block: oc has no --auto, and cl asks before every tool.
auto_tool() {
    local first=${1%% *} rest=""
    [[ $1 == *' '* ]] && rest=" ${1#* }"
    case $first in
        oc | opencode) first=oca ;;
        cl | claude) first=cca ;;
    esac
    printf '%s%s\n' "$first" "$rest"
}

# The model and effort `new` saved for a worktree, in its own git dir so that
# git worktree remove deletes them.
launch_file() {
    local gitdir
    gitdir=$(git -C "$1" rev-parse --path-format=absolute --git-dir 2>/dev/null) || return 1
    printf '%s/ai-launch\n' "$gitdir"
}

launch_settings() {
    local file key value model="" effort=""
    file=$(launch_file "$1") || return 1
    [[ -f $file ]] || return 1
    while IFS='=' read -r key value; do
        case $key in
            model) model=$value ;;
            effort) effort=$value ;;
        esac
    done <"$file"
    printf '%s|%s\n' "$model" "$effort"
}

# An empty value keeps the saved one.
launch_save() {
    local dir=$1 model=$2 effort=$3 file saved old_model="" old_effort=""
    file=$(launch_file "$dir") || return 1
    if saved=$(launch_settings "$dir"); then
        IFS='|' read -r old_model old_effort <<<"$saved"
    fi
    printf 'model=%s\neffort=%s\n' "${model:-$old_model}" "${effort:-$old_effort}" >"$file"
}

# <project>/<branch>, the name Claude sessions get so peers can address them.
session_name() {
    local dir=$1 common branch
    common=$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
    branch=$(git -C "$dir" branch --show-current 2>/dev/null) || branch=""
    [[ -n $branch ]] || branch=$(basename "$dir")
    printf '%s/%s\n' "$(basename "$(dirname "$common")")" "$branch"
}

# The full command line for a harness in dir. With a prompt, it ends in
# "$WTO_PROMPT", which the pane's launcher reads from the prompt file.
build_launch() {
    local tool=$1 dir=$2 with_prompt=$3 expanded bin name saved model="" effort=""
    expanded=$(tool_command "$tool")
    bin=${expanded%% *}
    bin=${bin##*/}
    # Each worktree is a new Grok workspace; without --trust the TUI blocks on
    # "Do you trust this directory?" and an unattended agent never starts.
    if [[ $bin == grok && " $expanded " != *' --trust '* ]]; then
        expanded+=' --trust'
    fi
    if [[ $bin == claude && " $expanded " != *' --name '* && " $expanded " != *' -n '* ]] \
        && name=$(session_name "$dir"); then
        expanded+=" --name $(printf '%q' "$name")"
    fi
    if [[ $bin == claude || $bin == grok ]] && saved=$(launch_settings "$dir"); then
        IFS='|' read -r model effort <<<"$saved"
    fi
    if [[ $bin == claude ]]; then
        [[ -n $model && " $expanded " != *' --model '* ]] && expanded+=" --model $(printf '%q' "$model")"
        [[ -n $effort && " $expanded " != *' --effort '* ]] && expanded+=" --effort $(printf '%q' "$effort")"
    elif [[ $bin == grok ]]; then
        [[ -n $model && " $expanded " != *' --model '* && " $expanded " != *' -m '* ]] \
            && expanded+=" -m $(printf '%q' "$model")"
        [[ -n $effort && " $expanded " != *' --reasoning-effort '* && " $expanded " != *' --effort '* ]] \
            && expanded+=" --reasoning-effort $(printf '%q' "$effort")"
    fi
    if [[ -n $with_prompt ]]; then
        # OpenCode's positional argument is a directory, not a prompt.
        # shellcheck disable=SC2016 # expanded later, in the pane's launcher
        if [[ $bin == opencode ]]; then
            expanded+=' --prompt="$WTO_PROMPT"'
        else
            expanded+=' "$WTO_PROMPT"'
        fi
    fi
    printf '%s\n' "$expanded"
}

# A prompt file the agent pane's launcher reads once and deletes.
prompt_file() {
    local text=$1 file
    file=$(mktemp "${TMPDIR:-/tmp}/wto-prompt.XXXXXX") || die "mktemp failed"
    printf '%s' "$text" >"$file" || {
        rm -f -- "$file"
        die "could not write the prompt file"
    }
    printf '%s\n' "$file"
}

grok_trust_folder() {
    local path=$1 dest="$HOME/.grok/trusted_folders.toml" header
    [[ -n $path ]] || return 0
    path=$(readlink -f -- "$path" 2>/dev/null || printf '%s' "$path")
    [[ -n $path && $path != / && $path != "$HOME" ]] || return 0
    header="[folders.\"${path}\"]"
    mkdir -p "$HOME/.grok"
    if [[ ! -f $dest ]]; then
        : >"$dest"
        chmod 600 "$dest" || true
    fi
    grep -Fq -- "$header" "$dest" 2>/dev/null && return 0
    if [[ -s $dest ]]; then
        [[ -n $(tail -c1 "$dest" 2>/dev/null || true) ]] && printf '\n' >>"$dest"
        printf '\n' >>"$dest"
    fi
    {
        printf '%s\n' "$header"
        printf 'trusted = true\n'
        printf 'decided_at = %s\n' "$(date +%s)"
    } >>"$dest"
    chmod 600 "$dest" 2>/dev/null || true
}

# Pre-accept Claude's trust dialog. Running sessions rewrite ~/.claude.json
# often, so only swap in our copy when the file is unchanged since we read it,
# and try again when it changed.
claude_trust_folder() {
    local dir=$1 cfg="$HOME/.claude.json" before tmp try
    [[ -n $dir && -f $cfg ]] || return 0
    dir=$(readlink -f -- "$dir" 2>/dev/null || printf '%s' "$dir")
    [[ -n $dir && $dir != / && $dir != "$HOME" ]] || return 0
    for try in 1 2 3 4 5; do
        jq -e --arg d "$dir" '.projects[$d].hasTrustDialogAccepted == true' "$cfg" >/dev/null 2>&1 \
            && return 0
        ((try == 1)) || sleep 0.2
        before=$(cksum <"$cfg")
        tmp=$(mktemp "$cfg.XXXXXX") || return 0
        if jq --arg d "$dir" '.projects[$d].hasTrustDialogAccepted = true' "$cfg" >"$tmp" \
            && [[ $(cksum <"$cfg") == "$before" ]]; then
            chmod 600 "$tmp"
            mv -- "$tmp" "$cfg"
        else
            rm -f -- "$tmp"
        fi
    done
    return 0
}

# Grok session to resume for a worktree. grok -c continues the newest session
# for the cwd, empty ones included, which shadows the last real conversation;
# pick the most recently active parent session with a title or real messages.
grok_resume_id() {
    local wt_path=$1 key dir id
    local -a summaries=()
    key=$(jq -nr --arg p "$wt_path" '$p|@uri') || return 1
    dir="${GROK_HOME:-$HOME/.grok}/sessions/$key"
    [[ -d $dir ]] || return 1
    summaries=("$dir"/*/summary.json)
    ((${#summaries[@]} > 0)) || return 1
    id=$(jq -rs '
        map(select(
            (.session_kind // "") != "subagent" and
            (.session_kind // "") != "subagent_resume" and
            (((.generated_title // "") | length) > 0 or ((.num_chat_messages // 0) > 2))
        ))
        | max_by(.last_active_at // .updated_at // "")
        | .info.id // empty
    ' "${summaries[@]}") || return 1
    [[ -n $id ]] || return 1
    printf '%s\n' "$id"
}

# True if the configured harness has a conversation for this path. Claude keeps
# transcripts under ~/.claude/projects/<path, non-alphanumerics as ->/;
# OpenCode has no probe.
has_session_history() {
    local wt_path=$1
    if is_grok "$AI_TOOL"; then
        grok_resume_id "$wt_path" >/dev/null
        return
    fi
    case ${AI_TOOL%% *} in
        cl | cca | claude)
            wt_path=$(readlink -f -- "$wt_path" 2>/dev/null || printf '%s' "$wt_path")
            [[ -n $(find "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects/${wt_path//[^a-zA-Z0-9]/-}" \
                -maxdepth 1 -name '*.jsonl' 2>/dev/null | head -n 1) ]]
            ;;
        *) return 1 ;;
    esac
}

is_grok() {
    case ${1%% *} in gra | grok | gr) return 0 ;; esac
    return 1
}

# The command a worktree window launches: a continued conversation when one
# exists, unless fresh is set (main always is: it is a home base).
window_tool() {
    local wt_path=$1 fresh=$2 resume_id cmd
    if [[ -n $fresh ]]; then
        cmd=$AI_TOOL
    elif is_grok "$AI_TOOL" && resume_id=$(grok_resume_id "$wt_path"); then
        cmd="$AI_TOOL -r $resume_id"
    elif has_session_history "$wt_path"; then
        cmd=$AI_TOOL_RESUME
    else
        cmd=$AI_TOOL
    fi
    auto_tool "$cmd"
}

# Worktrees of a project share a parent dir, so the session takes that dir's
# name, unless this client already sits in the project under another session
# name (opened with `tn`), whose session then gets the new windows.
session_for() {
    local root cur_session cur_path
    root=$(dirname "$1")
    if [[ -n ${TMUX:-} && -n ${TMUX_PANE:-} ]]; then
        cur_session=$(tmux display-message -t "$TMUX_PANE" -p '#{session_name}' 2>/dev/null) || cur_session=""
        cur_path=$(tmux display-message -t "$TMUX_PANE" -p '#{pane_current_path}' 2>/dev/null) || cur_path=""
        if [[ -n $cur_session && ($cur_path == "$root" || $cur_path == "$root"/*) ]]; then
            printf '%s\n' "$cur_session"
            return
        fi
    fi
    basename "$root"
}

# Window id (@N) by name. A name with a '.' (chore-upgrade-to-1.7.5) breaks a
# session:window target, which tmux reads as window.pane.
window_id() {
    local session=$1 name=$2 id wname
    while IFS=$'\t' read -r id wname; do
        [[ $wname == "$name" ]] && { printf '%s\n' "$id"; return 0; }
    done < <(tmux list-windows -t "=$session" -F "#{window_id}"$'\t'"#{window_name}" 2>/dev/null)
    return 1
}

goto_window() {
    local session=$1 name=$2 wid=""
    wid=$(window_id "$session" "$name") || wid=""
    if [[ -n ${TMUX:-} ]]; then
        tmux switch-client -t "=$session" 2>/dev/null || true
        [[ -n $wid ]] && tmux select-window -t "$wid" 2>/dev/null
    else
        [[ -n $wid ]] && tmux select-window -t "$wid" 2>/dev/null
        tmux attach -t "=$session"
    fi
    return 0
}

# The size of the client the window will be viewed at, minus the status bar
# rows tmux keeps outside the window. tav's splits are fixed at creation and
# tmux grows windows unevenly, so a window built at the 80x24 default and later
# attached to a taller client loses its proportions.
target_geometry() {
    local x y status lines
    if [[ -n ${TMUX:-} ]]; then
        x=$(tmux display-message -p '#{client_width}' 2>/dev/null) || x=""
        y=$(tmux display-message -p '#{client_height}' 2>/dev/null) || y=""
        status=$(tmux display-message -p '#{status}' 2>/dev/null) || status=""
        case $status in
            off) lines=0 ;;
            '' | *[!0-9]*) lines=1 ;;
            *) lines=$status ;;
        esac
    else
        x=$(tput cols 2>/dev/null) || x=""
        y=$(tput lines 2>/dev/null) || y=""
        lines=1
    fi
    [[ $x =~ ^[0-9]+$ ]] || x=220
    [[ $y =~ ^[0-9]+$ ]] || y=50
    printf '%s %s\n' "$x" "$((y - lines))"
}

# Run a send-keys later from the tmux server, so it survives this process.
schedule_send() {
    local pane=$1 delay=$2 keys=$3
    tmux run-shell -b "sleep $delay; tmux send-keys -t $pane $(printf '%q' "$keys") C-m"
}

# Grok treats Device Attributes / CPR replies as key input and leaves their
# body in its prompt (`0;2600;1c` from Alacritty, `84;0;0c` from tmux,
# `24;1R`). Clear the prompt only while that fingerprint shows, polling ~10s
# because nvim and LazyGit keep probing after first paint. run-shell -b belongs
# to the tmux server and uses /bin/sh.
schedule_da_scrub() {
    local pane=$1 script
    script=$(
        cat <<EOF
sleep 0.8
i=0
while [ "\$i" -lt 16 ]; do
  if tmux capture-pane -t '${pane}' -p -J 2>/dev/null \
      | tail -n 8 \
      | grep -qE '0;2600;1c|84;0;0c|[0-9]+;[0-9]+([;0-9]*)[cRu]'; then
    tmux send-keys -t '${pane}' C-u
  fi
  i=\$((i + 1))
  sleep 0.5
done
true
EOF
    )
    tmux run-shell -b "$script"
}

# Replace a pane with the agent. It starts under a bare bash after a quiet
# period that drains pending terminal replies, and drops into an interactive
# shell when it exits. Respawning the caller's own pane ends this process, so
# it is always the last step.
respawn_agent() {
    local pane=$1 dir=$2 launch=$3 pf=$4 bin wt_root inner outer drain read_prompt="" mark_exited=""
    bin=${launch%% *}
    bin=${bin##*/}
    case $bin in
        claude | grok | opencode)
            wt_root=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) || wt_root=$dir
            tmux set-option -p -t "$pane" @ai_tool "$bin" \; \
                set-option -p -t "$pane" @ai_wt "$wt_root" \; \
                set-option -p -t "$pane" @ai_state starting \; \
                set-option -p -t "$pane" @ai_state_at "$(date +%s)" \; \
                set-option -p -u -t "$pane" @ai_session 2>/dev/null || true
            # So `wto send` never types a message into the shell left behind.
            mark_exited="; tmux set-option -p -t $pane @ai_state exited \; set-option -p -t $pane @ai_state_at \$(date +%s) 2>/dev/null"
            ;;
    esac
    if [[ $bin == grok && -x $WTO_HOME/bin/tty-filter-da ]]; then
        launch="$WTO_HOME/bin/tty-filter-da $launch"
    fi
    # shellcheck disable=SC2016 # runs in the pane's bash, not here
    drain='
deadline=$((SECONDS + 1))
quiet=0
while (( SECONDS < deadline )); do
  if IFS= read -r -t 0.05 -n 1 _; then
    quiet=0
  else
    quiet=$((quiet + 1))
    (( quiet >= 5 )) && break
  fi
done
'
    [[ -n $pf ]] && read_prompt="WTO_PROMPT=\$(cat -- $(printf '%q' "$pf")); rm -f -- $(printf '%q' "$pf"); "
    inner=". \"\$HOME/.localrc\" 2>/dev/null || true; ${drain}${read_prompt}${launch}"
    outer="bash --noprofile --norc -c $(printf '%q' "$inner")${mark_exited}; exec $(printf '%q' "${SHELL:-bash}") -i"
    schedule_da_scrub "$pane"
    tmux respawn-pane -k -t "$pane" -c "$dir" "$outer"
}

# True when an agent harness runs in the pane: laying it out would end it.
pane_runs_agent() {
    local pid
    pid=$(tmux display-message -p -t "$1" '#{pane_pid}' 2>/dev/null) || return 1
    [[ -n $(harness_procs "$pid") ]]
}

# Agent on the left (with a shell below it), nvim with LazyGit on the right,
# and k9s below that with --k9s. The editor waits 2.5s: its terminal probes,
# started alongside the agent, are what leaks replies into the agent's input.
layout() {
    local pane=$1 dir=$2 tool=$3 pf=$4 k9s=$5 launch right
    launch=$(build_launch "$tool" "$dir" "$pf")
    grok_trust_folder "$dir"
    claude_trust_folder "$dir"
    right=$(tmux split-window -d -h -p 65 -t "$pane" -c "$dir" -P -F '#{pane_id}')
    tmux split-window -d -v -p 32 -t "$pane" -c "$dir"
    if [[ -n $k9s ]]; then
        schedule_send "$(tmux split-window -d -v -p 32 -t "$right" -c "$dir" -P -F '#{pane_id}')" 2.5 k9s
    fi
    tmux select-pane -t "$pane"
    schedule_send "$right" 2.5 'nvim . -c "lua vim.schedule(function() Snacks.lazygit() end)"'
    respawn_agent "$pane" "$dir" "$launch" "$pf"
}

# [{branch, path, main}] for the worktrees that have a branch.
wt_items() {
    wt_list | jq -c '[.items[] | select((.branch // "") != "")
        | {branch, path: .worktree.path, main: (.worktree.main == true)}]'
}

# Create one worktree's window and start its layout. Prints what it did. The
# prompt file is consumed either way.
ensure_window() {
    local branch=$1 wt_path=$2 pf=$3 fresh=$4 session window tool x y pane
    session=$(session_for "$wt_path")
    window=${branch//\//-}
    tool=$(window_tool "$wt_path" "$fresh")
    read -r x y < <(target_geometry)
    if ! tmux has-session -t "=$session" 2>/dev/null; then
        pane=$(tmux new-session -d -s "$session" -n "$window" -c "$wt_path" -x "$x" -y "$y" \
            -P -F '#{pane_id}' "$PLACEHOLDER")
    elif ! window_id "$session" "$window" >/dev/null; then
        # The trailing colon makes this a session target even when a window
        # shares the session's name. -d keeps the client where it is.
        pane=$(tmux new-window -d -t "=$session:" -n "$window" -c "$wt_path" -P -F '#{pane_id}' "$PLACEHOLDER")
        # Size it for its client before the splits; resize-window pins the
        # session to window-size manual, so restore the inherited default.
        tmux resize-window -t "$pane" -x "$x" -y "$y" 2>/dev/null || true
        tmux set-option -u -t "=$session" window-size 2>/dev/null || true
    else
        [[ -n $pf ]] && rm -f -- "$pf"
        printf '  skip    %s:%s (already exists)\n' "$session" "$window"
        return 0
    fi
    tmux set-window-option -t "$pane" allow-rename off 2>/dev/null || true
    layout "$pane" "$wt_path" "$tool" "$pf" ""
    printf '  create  %s:%s  (%s)\n' "$session" "$window" "$tool"
}

optval() {
    (($1 >= 2)) || die "$2 needs a value"
}

# -p text or -f file, into a prompt file for the launcher (empty: none).
prompt_arg() {
    local text=$1 file=$2
    if [[ -n $file ]]; then
        [[ -f $file ]] || die "prompt file not found: $file"
        text=$(cat -- "$file"; printf x)
        text=${text%x}
    fi
    [[ -n $text ]] && prompt_file "$text"
    return 0
}

cmd_new() {
    local branch="" base="" text="" file="" model="" effort="" switch=0 pf wt_path
    local name_re='^[A-Za-z0-9._:@/-]+(\[[A-Za-z0-9]+\])?$'
    while (($#)); do
        case $1 in
            -p | --prompt) optval $# "$1"; text=${2-}; shift ;;
            -f | --prompt-file) optval $# "$1"; file=${2-}; shift ;;
            -m | --model) optval $# "$1"; model=${2-}; shift ;;
            -e | --effort) optval $# "$1"; effort=${2-}; shift ;;
            -n | --no-switch) switch=0 ;;
            --switch) switch=1 ;;
            -h | --help) usage; return ;;
            -*) die "new: unknown option '$1'" ;;
            *)
                if [[ -z $branch ]]; then branch=$1
                elif [[ -z $base ]]; then base=$1
                else die "new: too many arguments"
                fi
                ;;
        esac
        shift
    done
    [[ -n $branch ]] || die "new: name the branch (wto new [-m model] [-e effort] [-p text] <branch> [base])"
    if [[ -n $model && ! $model =~ $name_re ]] || [[ -n $effort && ! $effort =~ ^[a-z]+$ ]]; then
        die "new: bad --model or --effort value"
    fi
    load_ai_tool

    # A branch that exists locally or on origin is switched to (wt then makes
    # a local tracking branch); only a new one takes a base.
    local -a create=(switch "$branch" --no-cd)
    if ! git show-ref --verify --quiet "refs/heads/$branch" \
        && ! git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
        create=(switch --create "$branch" --no-cd)
        [[ -n $base ]] && create+=(--base "$base")
    elif [[ -n $base ]]; then
        printf 'wto: %s already exists; ignoring base %s\n' "$branch" "$base" >&2
    fi
    wt "${create[@]}" || die "new: could not create the worktree for '$branch'"
    wt_path=$(wt_items | jq -r --arg b "$branch" '.[] | select(.branch == $b) | .path')
    [[ -n $wt_path ]] || die "new: worktree for '$branch' not found after create"

    if [[ -n $model || -n $effort ]]; then
        case ${AI_TOOL%% *} in
            oc | oca | opencode)
                printf 'wto: OpenCode takes no per-session model or effort; it starts on its configured default\n' >&2
                ;;
            *) launch_save "$wt_path" "$model" "$effort" || die "new: could not save model/effort for '$branch'" ;;
        esac
    fi
    pf=$(prompt_arg "$text" "$file")
    ensure_window "$branch" "$wt_path" "$pf" ""
    open_finish "$wt_path" "$branch" "$switch"
}

open_finish() {
    local wt_path=$1 branch=$2 switch=$3 session
    session=$(session_for "$wt_path")
    if ((switch)); then
        goto_window "$session" "${branch//\//-}"
    else
        printf '  ready   %s:%s  (staying put)\n' "$session" "${branch//\//-}"
    fi
}

cmd_open() {
    local branch="" text="" file="" switch=0 all=0 items count pf wt_path main
    while (($#)); do
        case $1 in
            -p | --prompt) optval $# "$1"; text=${2-}; shift ;;
            -f | --prompt-file) optval $# "$1"; file=${2-}; shift ;;
            --switch) switch=1 ;;
            -n | --no-switch) switch=0 ;;
            --all) all=1 ;;
            -h | --help) usage; return ;;
            --) shift; [[ -z $branch && $# -gt 0 ]] && branch=$1 ;;
            -*) die "open: unknown option '$1'" ;;
            *) [[ -z $branch ]] && branch=$1 ;;
        esac
        (($#)) && shift
    done
    load_ai_tool
    items=$(wt_items)
    count=$(jq length <<<"$items")
    ((count > 0)) || die "open: no worktrees found (run inside a worktrunk project)"
    if ((all)); then
        open_all "$items" "$switch"
        return
    fi
    if [[ -z $branch ]]; then
        if ((count == 1)); then
            branch=$(jq -r '.[0].branch' <<<"$items")
        elif [[ -t 0 && -t 1 ]] && command -v fzf >/dev/null 2>&1; then
            branch=$(jq -r 'sort_by([(.main | not), .branch]) | .[].branch' <<<"$items" \
                | fzf --prompt="Worktree: " --height=40% --reverse) || return 0
            [[ -n $branch ]] || return 0
        else
            die "open: name the branch (or install fzf for a picker)"
        fi
    fi
    wt_path=$(jq -r --arg b "$branch" '.[] | select(.branch == $b) | .path' <<<"$items")
    [[ -n $wt_path ]] || die "open: no worktree for '$branch'"
    main=$(jq -r --arg b "$branch" '.[] | select(.branch == $b) | .main' <<<"$items")
    pf=$(prompt_arg "$text" "$file")
    ensure_window "$branch" "$wt_path" "$pf" "$([[ $main == true ]] && echo 1)"
    open_finish "$wt_path" "$branch" "$switch"
}

# Every worktree, main first. Inside tmux, a launcher that is a single bare
# pane in this project (outside any feature worktree) becomes main's window,
# when it is main's window already or main has none; it is laid out last,
# since respawning it ends this process.
open_all() {
    local items=$1 switch=$2 session first_window main_path adopt="" branch path main
    local cur_session cur_path cur_window cur_panes inside
    session=$(session_for "$(jq -r '.[0].path' <<<"$items")")
    items=$(jq -c 'sort_by([(.main | not), .branch])' <<<"$items")
    first_window=$(jq -r '.[0].branch | gsub("/"; "-")' <<<"$items")
    main_path=$(jq -r '[.[] | select(.main)][0].path // empty' <<<"$items")
    if [[ -n ${TMUX:-} && -n ${TMUX_PANE:-} && -n $main_path ]]; then
        cur_session=$(tmux display-message -t "$TMUX_PANE" -p '#{session_name}' 2>/dev/null) || cur_session=""
        cur_path=$(tmux display-message -t "$TMUX_PANE" -p '#{pane_current_path}' 2>/dev/null) || cur_path=""
        cur_window=$(tmux display-message -t "$TMUX_PANE" -p '#{window_name}' 2>/dev/null) || cur_window=""
        cur_panes=$(tmux display-message -t "$TMUX_PANE" -p '#{window_panes}' 2>/dev/null) || cur_panes=""
        inside=$(jq -r --arg c "$cur_path" \
            'any(.[]; .path as $p | (.main | not) and ($c == $p or ($c | startswith($p + "/"))))' <<<"$items")
        if [[ $cur_session == "$session" && $inside == false && ${cur_panes:-1} == 1 ]] \
            && ! pane_runs_agent "$TMUX_PANE" \
            && { [[ $cur_window == "$first_window" ]] || ! window_id "$session" "$first_window" >/dev/null; }; then
            adopt=$TMUX_PANE
        fi
    fi
    while IFS=$'\t' read -r branch path main; do
        if [[ $main == true && -n $adopt ]]; then
            tmux rename-window -t "$adopt" "${branch//\//-}"
            tmux set-window-option -t "$adopt" allow-rename off 2>/dev/null || true
            printf '  adopt   %s:%s  (%s)\n' "$session" "${branch//\//-}" "$(window_tool "$path" 1)"
            continue
        fi
        ensure_window "$branch" "$path" "" "$([[ $main == true ]] && echo 1)"
    done < <(jq -r '.[] | "\(.branch)\t\(.path)\t\(.main)"' <<<"$items")
    if [[ -n $adopt ]]; then
        layout "$adopt" "$main_path" "$(window_tool "$main_path" 1)" "" ""
    elif ((switch)); then
        goto_window "$session" "$first_window"
    fi
}

cmd_layout() {
    local tool="" text="" file="" k9s="" pf dir
    while (($#)); do
        case $1 in
            -t | --tool) optval $# "$1"; tool=${2-}; shift ;;
            -f | --prompt-file) optval $# "$1"; file=${2-}; shift ;;
            -p | --prompt) optval $# "$1"; text=${2-}; shift ;;
            --k9s) k9s=1 ;;
            -h | --help) usage; return ;;
            --) shift; break ;;
            -*) die "layout: unknown option '$1'" ;;
            *) break ;;
        esac
        shift
    done
    (($#)) && text="$*"
    [[ -n ${TMUX:-} && -n ${TMUX_PANE:-} ]] || die "layout: run it inside tmux"
    pane_runs_agent "$TMUX_PANE" && die "layout: an agent runs in this pane; laying it out would end it"
    if [[ -z $tool ]]; then
        tool=${AI_TOOL:-}
        [[ -n $tool ]] || { load_ai_tool; tool=$AI_TOOL; }
    fi
    dir=$PWD
    pf=$(prompt_arg "$text" "$file")
    tmux rename-window -t "$TMUX_PANE" "$(basename "$dir")"
    layout "$TMUX_PANE" "$dir" "$tool" "$pf" "$k9s"
}

# ── close ─────────────────────────────────────────────────────────────────────

cmd_close() {
    local branch=${1:-} entry path main_path state dirty status pane window since live
    [[ -n $branch && $branch != -* ]] || die "close: name the branch to close"
    entry=$(roster_json | jq -c --arg b "$branch" '.[] | select(.branch == $b)')
    [[ -n $entry ]] || die "close: no worktree for '$branch'"
    path=$(jq -r .path <<<"$entry")
    main_path=$(roster_json | jq -r '[.[] | select(.main)][0].path')
    [[ $(jq -r .main <<<"$entry") != true ]] || die "close: refusing to close the main worktree"
    [[ $(self_wt) != "$path" ]] || die "close: run it from another worktree, not the one being closed"
    dirty=$(jq -r .dirty <<<"$entry")
    state=$(jq -r '.state // ""' <<<"$entry")
    [[ $dirty == false ]] || die "close: $branch has uncommitted changes, or wt could not read its status (a worktree whose directory is gone needs git worktree prune)"
    [[ $state == integrated || $state == empty ]] \
        || die "close: $branch is not merged into $(jq -r .default_branch <<<"$entry") (state: ${state:-unknown})"
    # Everything wt remove could still refuse is checked before the window goes.
    if git worktree list --porcelain | awk -v p="$path" '
        $1 == "worktree" { cur = substr($0, 10) } $1 == "locked" && cur == p { found = 1 } END { exit !found }'; then
        die "close: $branch's worktree is locked (git worktree unlock)"
    fi
    status=$(git -C "$path" status --porcelain) || die "close: cannot read the status of $path"
    [[ -z $status ]] || die "close: $branch has uncommitted changes"

    pane=$(jq -r '.session.pane // empty' <<<"$entry")
    if [[ -n $pane ]]; then
        window=$(tmux display-message -p -t "$pane" '#{window_id}' 2>/dev/null) || window=""
        [[ -n $window ]] && tmux kill-window -t "$window"
    fi
    since=$(date +%s)
    wt -C "$main_path" remove "$branch" --foreground --yes \
        || die "close: wt remove failed; the window is closed but the worktree and its claims remain (reopen with wto open $branch)"
    # The worktree is gone, so the grant pass drops its claims and hands them
    # on. worktrunk's post-remove hook may have run it already, out of sight,
    # so report every grant made since the removal started.
    if ! live=$(live_wts) || ! with_lock claim_gc_locked "$live" >/dev/null; then
        printf 'wto: claims of %s not handed over yet; run wto claim gc\n' "$branch" >&2
    fi
    claims_read | jq -r --argjson since "$since" '
        [.holders | to_entries[] | select((.value.granted_at // 0) >= $since and .value.acked_at == null)]
        | group_by(.value.wt)[]
        | "granted \(map(.key) | join(",")) to \(.[0].value.branch) — tell that session it is its turn"'
    printf 'closed %s\n' "$branch"
}

main() {
    local cmd=${1:-}
    (($#)) && shift
    case $cmd in
        ls) require wt jq git; cmd_ls "$@" ;;
        here) require wt jq git tmux; cmd_here "$@" ;;
        dir) require git; state_dir ;;
        profile) require git; cmd_profile "$@" ;;
        send) require wt jq git tmux; cmd_send "$@" ;;
        header) require jq git; cmd_header "$@" ;;
        claim) require wt jq git; cmd_claim "$@" ;;
        close) require wt jq git tmux; cmd_close "$@" ;;
        new) require wt jq git tmux; cmd_new "$@" ;;
        open) require wt jq git tmux; cmd_open "$@" ;;
        layout) require jq git tmux; cmd_layout "$@" ;;
        '' | -h | --help | help) usage ;;
        *) die "unknown command '$cmd' (see wto --help)" ;;
    esac
}

# One line, so bash has read the exit before main runs: a long run (an attach, a
# claim wait) can outlive an edit to this file, and bash reads scripts as it goes.
main "$@"; exit
