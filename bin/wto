#!/usr/bin/env bash
# wto — coordinate agent sessions across a project's git worktrees
#
# Usage: wto <command> [args]   (run anywhere inside the project)
# shellcheck disable=SC2329 # the *_locked functions run through with_lock
set -Eeuo pipefail
shopt -s inherit_errexit nullglob

# OpenCode's npm build runs as opencode.exe on Linux too.
readonly HARNESSES='claude|grok|opencode(\\.exe)?'

die() {
    printf 'wto: %s\n' "$*" >&2
    exit 1
}

warn() {
    printf 'wto: %s\n' "$*" >&2
}

usage() {
    cat <<'EOF'
Usage: wto <command> [args]

  ls [--json] [--files]        roster: every worktree with its git state, agent session,
                               and the model and effort wtc saved for it
  default [--refresh]          print the default branch; --refresh fetches origin and
                               fast-forwards the local default branch to it
  here                         print the live orchestrator marker (exit 1 if none)
  here --orchestrator          mark the calling pane as this project's orchestrator
  here --clear [--force]       remove the orchestrator marker
  dir                          print this project's state directory
  profile [--path]             print the project profile (exit 1 if there is none)
  send <name|--orchestrator|--all> [--relay] [--force] [-f file | message...]
                               deliver a message to another session, with the origin header
  header [--relay]             print the origin header for this session

  claim define [<resource>...]  set (or print) the names claims may use
  claim take <resource>... [--note text]   take all of them, or queue (exit 2)
  claim free [<resource>...|--all] [--force]   free and hand over to the next waiter
  claim check <resource>...    exit 0 only if this worktree holds all of them
  claim wait [--timeout secs]  wait for this worktree's queued request (default 60s)
  claim status [--json]        holders and the queue
  claim bump <name>            move that session's waiting requests to the front
  claim gc                     drop claims of removed worktrees, then hand over
  close <name>                 close a finished session: kill its window, remove its
                               worktree, delete its branch

  new [-j job] [-m model] [-e effort] [-p text | -f file] [--switch] [<branch> [base]]
                               open a session in a new codename folder (stays put unless
                               --switch). No branch: detached at the latest default branch.
                               -j takes the model and effort from ai/models.yaml, -m/-e
                               override it; saved for later launches.
  open [-p text | -f file] [--switch] [<name>]
                               open a worktree's window, continuing its conversation;
                               no name: the only worktree, or a picker
  open --all [--switch]        open every worktree
  layout [--k9s] [-t tool] [-p text | -f file | prompt...]
                               lay out the calling pane: agent, editor, shell

A <name> is a branch or a worktree folder name.

Agent commands come from $AI_TOOL / $AI_TOOL_RESUME (read from ~/.localrc
when unset); the shortcuts cl, cca, gr, gra, oc and oca mean what .aliases says.

Exit codes for send to one target: 4 no session, 5 exited, 6 blocked on a
question or state unknown (--force sends anyway), 7 launched too recently.
claim exits 75 when the claim lock stays busy for 5 seconds.

Agent sessions are found by the tmux pane options that tav sets (@ai_tool,
@ai_wt, @ai_state).
EOF
}

require() {
    local cmd
    for cmd in "$@"; do
        command -v "$cmd" >/dev/null 2>&1 || die "$cmd is required"
    done
}

# merge-tree --write-tree needs git 2.38.
require_git() {
    local v major minor
    v=$(git version) || die "git is required"
    v=${v#git version }
    IFS=. read -r major minor _ <<<"$v"
    ((major > 2 || (major == 2 && minor >= 38))) || die "git 2.38 or newer is required (found $v)"
}

common_dir() {
    git rev-parse --path-format=absolute --git-common-dir 2>/dev/null || die "not inside a git repository"
}

# The folder that holds the worktrees: the parent of a bare project's .git.
project_root() {
    local common
    common=$(common_dir)
    realpath -- "$(dirname "$common")"
}

is_bare_project() {
    [[ $(git --git-dir="$(common_dir)" rev-parse --is-bare-repository 2>/dev/null) == true ]]
}

# The calling worktree, or the project root when called from a bare project's
# root, which has no work tree.
self_top() {
    git rev-parse --show-toplevel 2>/dev/null || project_root
}

self_wt() {
    git rev-parse --show-toplevel 2>/dev/null \
        || die "run this inside a session folder, not at the project root"
}

# A branch name, or the folder name when detached or outside a work tree.
label_for() {
    local dir=$1 b=""
    if [[ $(git -C "$dir" rev-parse --is-inside-work-tree 2>/dev/null) == true ]]; then
        b=$(git -C "$dir" symbolic-ref -q --short HEAD 2>/dev/null) || b=""
    fi
    printf '%s\n' "${b:-${dir##*/}}"
}

self_label() {
    label_for "$(self_top)"
}

state_dir() {
    local common
    common=$(common_dir)
    [[ -d $common/orchestrate ]] || mkdir -p -- "$common/orchestrate"
    printf '%s\n' "$common/orchestrate"
}

# ── default branch ────────────────────────────────────────────────────────────

default_branch() {
    local ref b
    if ref=$(git symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null); then
        printf '%s\n' "${ref#origin/}"
        return 0
    fi
    for b in main master; do
        if git show-ref --verify --quiet "refs/heads/$b"; then
            printf '%s\n' "$b"
            return 0
        fi
    done
    git --git-dir="$(common_dir)" symbolic-ref -q --short HEAD 2>/dev/null
}

fetch_origin() {
    local -a cmd=(git fetch --quiet origin)
    [[ -n ${WTO_NO_FETCH-} ]] && return 0
    git remote get-url origin >/dev/null 2>&1 || return 0
    command -v timeout >/dev/null 2>&1 && cmd=(timeout 20 "${cmd[@]}")
    if ! GIT_TERMINAL_PROMPT=0 GIT_SSH_COMMAND=${GIT_SSH_COMMAND:-ssh -o BatchMode=yes} "${cmd[@]}" </dev/null; then
        warn "could not fetch origin; using local refs"
    fi
    if ! git show-ref --verify --quiet refs/remotes/origin/HEAD; then
        git remote set-head origin --auto >/dev/null 2>&1 || true
    fi
}

# Keep the local default branch at or ahead of origin's: closeout fast-forwards
# only the local ref, and rebases, merge checks and the issue gate read it.
# Prints the ref new sessions start from.
sync_default() {
    local d=$1 local_ref=refs/heads/$1 origin_ref=refs/remotes/origin/$1 l o
    o=$(git rev-parse -q --verify "$origin_ref^{commit}" 2>/dev/null) || o=""
    l=$(git rev-parse -q --verify "$local_ref^{commit}" 2>/dev/null) || l=""
    if [[ -z $o ]]; then
        [[ -n $l ]] || die "no branch $d here or on origin"
        printf '%s\n' "$local_ref"
        return 0
    fi
    if [[ -z $l ]] || { [[ $l != "$o" ]] && git merge-base --is-ancestor "$l" "$o"; }; then
        if git fetch --quiet . "$origin_ref:$local_ref" 2>/dev/null; then
            printf '%s\n' "$local_ref"
        else
            warn "$d is checked out in a folder and behind origin; left as is, starting from origin/$d"
            printf '%s\n' "$origin_ref"
        fi
        return 0
    fi
    if [[ $l != "$o" ]] && ! git merge-base --is-ancestor "$o" "$l"; then
        warn "$d and origin/$d have diverged; starting from the local $d"
    fi
    printf '%s\n' "$local_ref"
}

cmd_default() {
    local refresh=0 d
    while (($#)); do
        case $1 in
            --refresh) refresh=1 ;;
            -h | --help) usage; return ;;
            *) die "default: unknown option '$1'" ;;
        esac
        shift
    done
    ((refresh)) && fetch_origin
    d=$(default_branch) || die "cannot tell the default branch (git remote set-head origin --auto)"
    ((refresh)) && sync_default "$d" >/dev/null
    printf '%s\n' "$d"
}

# ── roster ────────────────────────────────────────────────────────────────────

# path, HEAD, branch, locked, prunable for each worktree, \x1f-separated (read
# collapses runs of tab separators). The bare repository's own entry is left out.
worktree_rows() {
    git worktree list --porcelain | awk '
        function flush() {
            if (path != "" && !bare) printf "%s\037%s\037%s\037%s\037%s\n", path, head, branch, locked, prunable
            path = ""; head = ""; branch = ""; bare = 0; locked = 0; prunable = 0
        }
        /^worktree / { flush(); path = substr($0, 10); next }
        /^HEAD / { head = substr($0, 6); next }
        /^branch / { branch = substr($0, 8); sub(/^refs\/heads\//, "", branch); next }
        /^bare$/ { bare = 1; next }
        /^locked/ { locked = 1; next }
        /^prunable/ { prunable = 1; next }
        END { flush() }'
}

# How commit $1 is already part of $2: ancestor, or trees when merging it would
# change nothing (a squash merge). Fails when it is not.
integrated_reason() {
    local head=$1 target=$2 tree
    git rev-parse -q --verify "$target^{commit}" >/dev/null 2>&1 || return 1
    if git merge-base --is-ancestor "$head" "$target" 2>/dev/null; then
        printf 'ancestor\n'
        return 0
    fi
    tree=$(git merge-tree --write-tree --no-messages "$target" "$head" 2>/dev/null) || return 1
    [[ ${tree%%$'\n'*} == "$(git rev-parse "$target^{tree}")" ]] || return 1
    printf 'trees\n'
}

# Physical path of directory $2 into variable $1, or $2 itself when it cannot
# be entered: cd -P instead of a realpath process per worktree.
resolve_dir() {
    local _rd_start=$PWD
    if cd -P -- "$2" 2>/dev/null; then
        printf -v "$1" '%s' "$PWD"
        cd -- "$_rd_start" || die "cannot return to $_rd_start"
    else
        printf -v "$1" '%s' "$2"
    fi
}

# The git dir of worktree $2 into variable $1, read from its .git (a gitfile
# in a linked worktree) so that no git process runs; git answers otherwise.
git_dir_of() {
    local _gd_line=""
    if [[ -d $2/.git ]]; then
        printf -v "$1" '%s' "$2/.git"
    elif [[ -f $2/.git ]] && { IFS= read -r _gd_line <"$2/.git" || [[ -n $_gd_line ]]; } \
        && [[ $_gd_line == 'gitdir: '?* ]]; then
        _gd_line=${_gd_line#gitdir: }
        [[ $_gd_line == /* ]] || _gd_line=$2/$_gd_line
        printf -v "$1" '%s' "$_gd_line"
    else
        _gd_line=$(git -C "$2" rev-parse --path-format=absolute --git-dir 2>/dev/null) || return 1
        printf -v "$1" '%s' "$_gd_line"
    fi
}

# The operation stopped in git dir $2 (rebase, merge, ...) into variable $1.
git_operation() {
    local _op=""
    if [[ -d $2/rebase-merge || -d $2/rebase-apply ]]; then _op=rebase
    elif [[ -f $2/MERGE_HEAD ]]; then _op=merge
    elif [[ -f $2/CHERRY_PICK_HEAD ]]; then _op=cherry-pick
    elif [[ -f $2/REVERT_HEAD ]]; then _op=revert
    elif [[ -f $2/BISECT_LOG ]]; then _op=bisect
    fi
    printf -v "$1" '%s' "$_op"
}

# One \x1f-separated row per worktree: path, head, branch, dirty, conflicted,
# operation, ahead, behind, state, integrated, rebase conflicts, fresh. Fast
# mode leaves out everything that needs a status or merge check.
worktree_facts() {
    local fast=$1 default=$2 path head branch real dirty conflicted op gitdir
    local ahead behind state reason rconf fresh counts status log rc tree default_ref="" default_tree=""
    # Porcelain XY codes of an unmerged path.
    local unmerged=$'\n(DD|AU|UD|UA|DU|AA|UU) '
    local work=$'\t(commit|rebase|merge|cherry-pick|am|revert)'
    [[ -n $default ]] && git show-ref --verify --quiet "refs/heads/$default" && default_ref=refs/heads/$default
    while IFS=$'\037' read -r path head branch _ _; do
        resolve_dir real "$path"
        dirty=null conflicted=false op="" ahead=null behind=null state="" reason="" rconf=false fresh=null
        if ((!fast)) && [[ -d $real ]]; then
            # `exec`: bash forks twice for a redirected command in $(...).
            if status=$(GIT_OPTIONAL_LOCKS=0 exec git -C "$real" status --porcelain 2>/dev/null); then
                if [[ -n $status ]]; then dirty=true; else dirty=false; fi
                [[ $'\n'$status =~ $unmerged ]] && conflicted=true
            fi
            git_dir_of gitdir "$real" || gitdir=""
            [[ -n $gitdir ]] && git_operation op "$gitdir"
            if [[ -n $default_ref && -n $head ]] \
                && counts=$(exec git rev-list --left-right --count "$default_ref...$head" 2>/dev/null); then
                read -r behind ahead <<<"$counts"
                if ((ahead == 0)); then
                    reason=ancestor
                    if ((behind == 0)); then state=empty; else state=integrated; fi
                else
                    rc=0
                    tree=$(exec git merge-tree --write-tree --no-messages "$default_ref" "$head" 2>/dev/null) || rc=$?
                    if ((rc == 1)); then
                        rconf=true
                    elif ((rc == 0)); then
                        [[ -n $default_tree ]] || default_tree=$(git rev-parse "$default_ref^{tree}")
                        if [[ ${tree%%$'\n'*} == "$default_tree" ]]; then
                            reason=trees
                            state=integrated
                        fi
                    fi
                fi
                fresh=false
                if ((ahead == 0)); then
                    # The reflog file's message field is what %gs prints.
                    if [[ -n $gitdir && -f $gitdir/logs/HEAD ]]; then
                        grep -Eq -e "$work" -- "$gitdir/logs/HEAD" || fresh=true
                    else
                        log=$(git -C "$real" reflog show --format=%gs HEAD 2>/dev/null) || log=""
                        grep -Eq '^(commit|rebase|merge|cherry-pick|am|revert)' <<<"$log" || fresh=true
                    fi
                fi
            fi
        fi
        printf '%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\037%s\n' "$real" "$head" "$branch" \
            "$dirty" "$conflicted" "$op" "$ahead" "$behind" "$state" "$reason" "$rconf" "$fresh"
    done < <(worktree_rows)
}

# Fields of `tmux list-panes -a` for the roster: one pass covers both the
# agent panes and the windows tagged for a worktree. #{@ai_wt} resolves the
# pane option first, then the window's.
PANE_FMT='#{pane_id}'$'\t''#{pane_pid}'$'\t''#{session_name}:#{window_name}'$'\t''#{@ai_tool}'
PANE_FMT+=$'\t''#{@ai_wt}'$'\t''#{@ai_state}'$'\t''#{@ai_state_at}'$'\t''#{pane_current_path}'
PANE_FMT+=$'\t''#{@ai_session}'$'\t''#{window_id}'
readonly PANE_FMT

# {<worktree path>: <window id>} for windows with a pane tagged for a worktree.
windows_json() {
    local rows
    rows=$(tmux list-panes -a -F '#{@ai_wt}'$'\t''#{window_id}' 2>/dev/null) || { printf '{}\n'; return; }
    jq -R -s -c '
        split("\n") | map(select(length > 0) | split("\t") | select(.[0] != ""))
        | reduce .[] as $r ({}; if has($r[0]) then . else . + {($r[0]): $r[1]} end)' <<<"$rows"
}

# "<pane pid>\t<harness>\t<args>" for each harness process under a pane.
harness_procs() {
    # ucomm, not comm: BSD ps prints comm as the full executable path.
    ps -e -o pid=,ppid=,ucomm=,args= | awk -v panes="$1" -v re="^($HARNESSES)$" '
        BEGIN { n = split(panes, p, ","); for (i = 1; i <= n; i++) pane[p[i]] = 1 }
        {
            pid = $1; ppid[pid] = $2; comm[pid] = $3; sub(/.*\//, "", comm[pid])
            $1 = $2 = $3 = ""; sub(/^ +/, ""); args[pid] = $0
        }
        END {
            for (pid in comm) {
                if (comm[pid] !~ re) continue
                cur = pid
                for (depth = 0; depth < 8 && cur != "" && cur != "1"; depth++) {
                    if (cur in pane) { name = comm[pid]; sub(/\.exe$/, "", name); print cur "\t" name "\t" args[pid]; break }
                    cur = ppid[cur]
                }
            }
        }'
}

# The roster; `roster_json fast` skips the git status and merge checks.
roster_json() {
    local fast=0 default facts pane_rows="" procs="" launch="" now claims='{}' dir orch_pane=""
    local path saved model effort pids="" pane pid
    [[ ${1-} == fast ]] && fast=1
    # Explicit returns: callers use `|| ...`, which turns off set -e in here.
    default=$(default_branch) || default=""
    facts=$(worktree_facts "$fast" "$default") || return 1
    # {model, effort} from the ai-launch file that `wtc --model/--effort`
    # writes into each worktree's git dir.
    while IFS=$'\037' read -r path _; do
        if [[ -z $path ]] || ! launch_settings_into saved "$path"; then
            continue
        fi
        IFS='|' read -r model effort <<<"$saved"
        launch+=$path$'\037'$model$'\037'$effort$'\n'
    done <<<"$facts"
    if pane_rows=$(tmux list-panes -a -F "$PANE_FMT" 2>/dev/null); then
        while IFS=$'\t' read -r pane pid _; do
            pids+=${pids:+,}$pid
        done <<<"$pane_rows"
        procs=$(harness_procs "$pids") || return 1
    else
        pane_rows=""
    fi
    now=${EPOCHSECONDS:-$(date +%s)}
    dir=$(state_dir)
    [[ -s $dir/claims/state.json ]] && claims=$(<"$dir/claims/state.json")
    marker_valid "$dir/orchestrator.json" && orch_pane=$MARKER_PANE
    jq -R -s -c --rawfile panes <(printf '%s' "$pane_rows") --rawfile procs <(printf '%s' "$procs") \
        --arg launch "$launch" --arg default "$default" --argjson now "$now" \
        --argjson claims "$claims" --arg orch "$orch_pane" '
        def nul: if . == "" then null else . end;
        def rows: split("\n") | map(select(length > 0));
        def under($p): . == $p or startswith($p + "/");
        def auto($args):
            if $args == null then null
            else ($args | test("bypassPermissions|--dangerously-skip-permissions|--always-approve|--auto(\\s|$)"))
            end;
        ($procs | rows | map(split("\t") | {key: .[0], value: {tool: .[1], args: .[2]}}) | from_entries) as $by_pid
        | ($panes | rows | map(split("\t")
            | {pane: .[0], pid: .[1], window: .[2], tag_tool: .[3], tag_wt: .[4],
               state: .[5], state_at: .[6], cwd: .[7], oc_session: (.[8] // ""), window_id: .[9]}
            | . + {proc: $by_pid[.pid]})) as $all_panes
        | ($all_panes | map(select(.tag_wt != ""))
            | reduce .[] as $r ({}; if has($r.tag_wt) then . else . + {($r.tag_wt): $r.window_id} end)) as $windows
        | ($all_panes | map(select(.tag_tool != "" or .proc != null))) as $panes
        | ($launch | rows | map(split("\u001f") | {key: .[0], value: {model: (.[1] | nul), effort: (.[2] | nul)}})
            | from_entries) as $launch
        | rows | map(split("\u001f")
            | {branch: (.[2] | nul), name: (.[0] | split("/") | last), path: .[0],
               detached: (.[2] == ""), dirty: (.[3] | fromjson),
               conflicted_files: (.[4] | fromjson), ahead: (.[6] | fromjson), behind: (.[7] | fromjson),
               rebase_conflicts: (.[10] | fromjson), integrated: (.[9] | nul), state: (.[8] | nul),
               fresh: (.[11] | fromjson), operation: (.[5] | nul), default_branch: ($default | nul)})
        | map(
            .path as $path
            # A live harness beats a pane left over from an earlier one, and the
            # orchestrator pane beats other agent panes.
            | (([$panes[] | select(.tag_wt == $path)]
                + [$panes[] | select(.tag_wt == "" and (.cwd | under($path)))])
               | sort_by([(if .proc != null and .state != "exited" then 0 else 1 end),
                          (if .pane == $orch then 0 else 1 end)])
               | first) as $pane
            | . + {
              claims: [($claims.holders // {}) | to_entries[] | select(.value.wt == $path) | .key],
              unacked_grants: [($claims.holders // {}) | to_entries[]
                  | select(.value.wt == $path and .value.granted_at != null and .value.acked_at == null) | .key],
              queued: [($claims.queue // [])[] | select(.wt == $path) | .res[]],
              launch: ($launch[$path] // null),
              window_id: ($windows[$path] // null),
              session: (if $pane == null then null else {
                  pane: $pane.pane,
                  window: $pane.window,
                  tool: (if $pane.tag_tool != "" then $pane.tag_tool else $pane.proc.tool end),
                  state: (if $pane.state != "" then $pane.state
                          elif $pane.proc != null then "unknown" else "exited" end),
                  state_age: (if ($pane.state_at | test("^[0-9]+$")) then $now - ($pane.state_at | tonumber) else null end),
                  auto_approve: auto($pane.proc.args),
                  running: ($pane.proc != null),
                  opencode_session: (if $pane.oc_session != "" then $pane.oc_session else null end),
                  tagged: ($pane.tag_tool != "")
              } end)
            })' <<<"$facts"
}

# The one roster entry a branch, folder name or path names.
resolve_entry() {
    local roster=$1 name=$2 what=$3 matches n
    matches=$(jq -c --arg n "$name" '
        [.[] | select(.path == $n)] as $exact
        | if ($exact | length) > 0 then $exact
          else [.[] | select(.branch == $n or .name == $n)] end' <<<"$roster")
    n=$(jq length <<<"$matches")
    ((n > 0)) || die "$what: no worktree for '$name'"
    ((n == 1)) || die "$what: '$name' names more than one worktree ($(jq -r 'map(.path) | join(", ")' <<<"$matches")); pass the folder path"
    jq -c '.[0]' <<<"$matches"
}

# {<worktree path>: <branch or folder name>} for printing claim holders.
labels_json() {
    worktree_rows | jq -R -s -c '
        split("\n") | map(select(length > 0) | split("\u001f")
            | {key: .[0], value: (if .[2] != "" then .[2] else (.[0] | split("/") | last) end)})
        | from_entries'
}

add_conflict_files() {
    local roster=$1 default head path merged rc files out=()
    default=$(jq -r '[.[].default_branch | select(. != null)][0] // empty' <<<"$roster")
    [[ -n $default ]] || { printf '%s\n' "$roster"; return; }
    while IFS= read -r path; do
        [[ -n $path ]] || continue
        head=$(git -C "$path" rev-parse HEAD 2>/dev/null) || continue
        # Exit 1 means "conflicts", which is the case this runs for.
        rc=0
        merged=$(git merge-tree --write-tree --name-only --no-messages "$default" "$head" 2>/dev/null) || rc=$?
        if ((rc == 0 || rc == 1)); then
            files=$(tail -n +2 <<<"$merged" | jq -R -s -c 'split("\n") | map(select(length > 0)) | unique')
        else
            files=null
        fi
        out+=("$(jq -n -c --arg p "$path" --argjson f "$files" '{($p): $f}')")
    done < <(jq -r '.[] | select(.rebase_conflicts) | .path' <<<"$roster")
    jq -c --argjson files "$(printf '%s\n' "${out[@]}" | jq -s -c 'add // {}')" \
        'map(. + {conflict_files: ($files[.path] // null)})' <<<"$roster"
}

cmd_ls() {
    local json=0 files=0 roster
    while (($#)); do
        case $1 in
            --json) json=1 ;;
            --files) files=1 ;;
            -h | --help) usage; return ;;
            *) die "ls: unknown option '$1'" ;;
        esac
        shift
    done
    roster=$(roster_json)
    ((files)) && roster=$(add_conflict_files "$roster")
    if ((json)); then
        jq . <<<"$roster"
        return
    fi
    jq -r '
        ["BRANCH", "FOLDER", "SESSION", "TOOL", "MODEL", "AHEAD", "BEHIND", "DIRTY", "REBASE", "CLAIMS", "WINDOW"],
        (.[] | [
            (.branch // "(no branch)"),
            .name,
            (if .session == null then "-"
             else .session.state + (if .session.state_age != null then " " + (.session.state_age / 60 | floor | tostring) + "m" else "" end)
             end),
            (.session.tool // "-"),
            (if .launch == null then "-"
             else [(.launch.model // "default"), (.launch.effort // empty)] | join(" ") end),
            (.ahead // "-" | tostring), (.behind // "-" | tostring),
            (if .dirty == null then "?" elif .dirty then "yes" else "-" end),
            (if .operation != null then .operation
             elif .rebase_conflicts then "conflicts"
             elif (.behind // 0) > 0 then "clean" else "-" end),
            ([(.claims | join(",") | select(. != "")),
              (if (.queued | length) > 0 then "waiting: " + (.queued | join(",")) else empty end)]
             | if length == 0 then "-" else join(" ") end),
            (.session.window // "-")
        ])
        | @tsv' <<<"$roster" | column -t -s $'\t'
    jq -r '.[] | select(.detached and (.ahead // 0) > 0 and .operation == null)
        | "wto: \(.name) has \(.ahead) commit(s) on no branch; name one there with git switch -c <branch>"' \
        <<<"$roster" >&2
}

# True when the marker names a live pane on this tmux server whose agent has
# not exited. Sets MARKER_PANE, MARKER_WINDOW and MARKER_PATH from it.
MARKER_PANE="" MARKER_WINDOW="" MARKER_PATH=""
marker_valid() {
    local marker=$1 fields tmux_pid live
    MARKER_PANE="" MARKER_WINDOW="" MARKER_PATH=""
    [[ -f $marker ]] || return 1
    fields=$(jq -r '[.pane, .tmux_pid, .window, .path] | map(. // "" | tostring) | join("\u001f")' \
        "$marker" 2>/dev/null) || return 1
    IFS=$'\037' read -r MARKER_PANE tmux_pid MARKER_WINDOW MARKER_PATH <<<"$fields"
    [[ -n $MARKER_PANE && -n $tmux_pid ]] || return 1
    live=$(tmux display-message -p -t "$MARKER_PANE" '#{pid}'$'\037''#{pane_id}'$'\037''#{@ai_state}' 2>/dev/null) \
        || return 1
    [[ $live == "$tmux_pid"$'\037'"$MARKER_PANE"$'\037'* ]] || return 1
    [[ ${live##*$'\037'} != exited ]]
}

cmd_here() {
    local mode=show force=0 dir marker top
    while (($#)); do
        case $1 in
            --orchestrator) mode='write' ;;
            --clear) mode=clear ;;
            --force) force=1 ;;
            -h | --help) usage; return ;;
            *) die "here: unknown option '$1'" ;;
        esac
        shift
    done
    dir=$(state_dir)
    marker=$dir/orchestrator.json

    case $mode in
        show)
            marker_valid "$marker" || return 1
            jq . "$marker"
            ;;
        write)
            [[ -n ${TMUX_PANE-} ]] || die "here: not inside tmux (TMUX_PANE unset)"
            top=$(self_wt)
            if marker_valid "$marker" && [[ $MARKER_PANE != "$TMUX_PANE" ]]; then
                printf 'wto: an orchestrator is already running in %s\n' "$MARKER_WINDOW" >&2
                return 3
            fi
            jq -n \
                --arg pane "$TMUX_PANE" \
                --arg tmux_pid "$(tmux display-message -p '#{pid}')" \
                --arg window "$(tmux display-message -p -t "$TMUX_PANE" '#{session_name}:#{window_name}')" \
                --arg tool "$(tmux show-options -pqv -t "$TMUX_PANE" @ai_tool)" \
                --arg branch "$(label_for "$top")" \
                --arg path "$top" \
                --argjson started "$(date +%s)" \
                '{pane: $pane, tmux_pid: $tmux_pid, window: $window, tool: $tool,
                  branch: $branch, path: $path, started: $started}' >"$marker.tmp"
            mv -- "$marker.tmp" "$marker"
            jq . "$marker"
            ;;
        clear)
            [[ -f $marker ]] || return 0
            if ((!force)) && marker_valid "$marker" && [[ $MARKER_PANE != "${TMUX_PANE-}" ]]; then
                die "here: the live orchestrator is another pane ($MARKER_WINDOW); use --force"
            fi
            rm -f -- "$marker"
            ;;
    esac
}

caller_header() {
    local relay=$1 common project role=session kind='agent notice' marker
    common=$(common_dir)
    project=$(basename "$(dirname "$common")")
    marker=$common/orchestrate/orchestrator.json
    if [[ -n ${TMUX_PANE-} ]] && marker_valid "$marker" && [[ $MARKER_PANE == "$TMUX_PANE" ]]; then
        role=orchestrator
    fi
    ((relay)) && kind="relaying the user's words"
    printf '[session message · from %s/%s (%s) · %s]\n' "$project" "$(self_label)" "$role" "$kind"
}

cmd_header() {
    local relay=0
    while (($#)); do
        case $1 in
            --relay) relay=1 ;;
            -h | --help) usage; return ;;
            *) die "header: unknown option '$1'" ;;
        esac
        shift
    done
    caller_header "$relay"
}

# Deliver one message to one roster entry. Returns the documented exit code.
deliver() {
    local entry=$1 body_file=$2 force=$3 label has_session pane tool state age running oc_session path buf
    # \x1f, not a tab: read collapses runs of whitespace separators, which
    # would shift every field after an empty one.
    IFS=$'\x1f' read -r label has_session pane tool state age running oc_session path < <(jq -r '[(.branch // .name),
        (.session != null), .session.pane, .session.tool, .session.state, (.session.state_age // -1),
        .session.running, (.session.opencode_session // ""), .path]
        | map(tostring) | join("\u001f")' <<<"$entry")
    if [[ $has_session != true ]]; then
        printf '%s: no session\n' "$label"
        return 4
    fi
    if [[ $pane == "${TMUX_PANE-}" ]]; then
        printf '%s: is this session, skipped\n' "$label"
        return 4
    fi
    if [[ $state == exited || $running != true ]]; then
        printf '%s: session has exited\n' "$label"
        return 5
    fi
    if [[ $state == blocked ]] || { [[ $state == unknown ]] && ((!force)); }; then
        printf '%s: %s; not sent%s\n' "$label" \
            "$([[ $state == blocked ]] && echo 'waiting on a question' || echo 'state unknown (session predates pane tags)')" \
            "$([[ $state == unknown ]] && echo '; close its window and run wta to reopen it tagged, or pass --force')"
        return 6
    fi
    if [[ $state == starting ]] && ((age >= 0 && age < 15)); then
        printf '%s: launched %ss ago; retry shortly\n' "$label" "$age"
        return 7
    fi

    if [[ $tool == opencode && -n $oc_session ]]; then
        (cd -- "$path" && opencode api session.prompt --param "sessionID=$oc_session" \
            --data "$(jq -n -c --rawfile text "$body_file" '{text: $text, delivery: "queue"}')") >/dev/null \
            || { printf '%s: opencode delivery failed\n' "$label"; return 1; }
    else
        buf="wto-$$-${RANDOM}"
        tmux load-buffer -b "$buf" "$body_file"
        tmux paste-buffer -d -p -b "$buf" -t "$pane"
        sleep 0.8
        tmux send-keys -t "$pane" Enter
    fi
    printf '%s: sent (%s, %s)\n' "$label" "$tool" "$state"
}

cmd_send() {
    local target="" relay=0 force=0 file="" roster body_file body rc=0 code entry marker orch_path
    local -a words=() entries=()
    while (($#)); do
        case $1 in
            --orchestrator | --all) target=$1 ;;
            --relay) relay=1 ;;
            --force) force=1 ;;
            -f) file=${2:?send: -f needs a file}; shift ;;
            -h | --help) usage; return ;;
            --) shift; words+=("$@"); break ;;
            -*) die "send: unknown option '$1'" ;;
            *) if [[ -z $target ]]; then target=$1; else words+=("$1"); fi ;;
        esac
        shift
    done
    [[ -n $target ]] || die "send: name a branch or folder, --orchestrator or --all"

    body_file=$(mktemp)
    # shellcheck disable=SC2064  # expand now: body_file is local, the trap runs at exit
    trap "rm -f -- $(printf '%q' "$body_file")" EXIT
    caller_header "$relay" >"$body_file"
    if [[ -n $file ]]; then
        cat -- "$file" >>"$body_file"
    elif ((${#words[@]})); then
        printf '%s\n' "${words[*]}" >>"$body_file"
    elif [[ ! -t 0 ]]; then
        cat >>"$body_file"
    else
        die "send: no message (pass words, -f file, or stdin)"
    fi
    # Pasted text must not end in a newline, or a TUI may submit early.
    body=$(<"$body_file")
    printf '%s' "$body" >"$body_file"

    roster=$(roster_json fast)
    case $target in
        --orchestrator)
            marker=$(state_dir)/orchestrator.json
            marker_valid "$marker" || die "send: no orchestrator is running (wto here)"
            orch_path=$MARKER_PATH
            mapfile -t entries < <(jq -c --arg p "$orch_path" '.[] | select(.path == $p)' <<<"$roster")
            ;;
        --all) mapfile -t entries < <(jq -c --arg self "$(self_top)" \
            '.[] | select(.path != $self and .session != null)' <<<"$roster") ;;
        *)
            entry=$(resolve_entry "$roster" "$target" send)
            entries=("$entry")
            ;;
    esac
    ((${#entries[@]})) || die "send: no worktree for '$target'"

    for entry in "${entries[@]}"; do
        code=0
        deliver "$entry" "$body_file" "$force" || code=$?
        ((code == 0)) || rc=$code
    done
    return "$rc"
}

# ── claims ────────────────────────────────────────────────────────────────────
# One JSON ledger per project, changed only under a lock file that is never
# replaced. A claim belongs to a worktree path (HEAD is detached mid-rebase, so
# a branch key would break), not to a process, so it survives restarts.

claims_dir() {
    local d
    d=$(state_dir)/claims
    mkdir -p -- "$d"
    printf '%s\n' "$d"
}

# {<worktree path>: label}, read once per run; the label stored with a claim is
# a snapshot from when it was taken, and a session may name its branch later.
WTO_LABELS='{}'

# Run "$@" in a subshell holding the claims lock: flock(1) where it exists,
# else perl's flock() on the same fd (macOS ships perl but not flock). Either
# way it is a flock(2) lock on the subshell's fd 9, held until the subshell
# exits and released by the kernel if it dies.
with_lock() {
    local lock
    lock=$(claims_dir)/lock
    (
        if command -v flock >/dev/null 2>&1; then
            flock -w 5 9 || exit 75
        elif command -v perl >/dev/null 2>&1; then
            # shellcheck disable=SC2016  # perl program, not shell
            perl -MFcntl=:flock -e 'open(my $f, ">&=", 9) or exit 1;
                for (1 .. 50) { exit 0 if flock($f, LOCK_EX | LOCK_NB); select(undef, undef, undef, 0.1) }
                exit 75' || exit $?
        else
            die "claim: needs flock or perl to lock the claims ledger"
        fi
        "$@"
    ) 9>>"$lock"
}

claims_read() {
    local f
    f=$(claims_dir)/state.json
    if [[ -s $f ]]; then cat -- "$f"; else printf '{"holders":{},"queue":[],"seq":0,"log":[]}\n'; fi
}

# A failed jq upstream hands this nothing; writing that would erase every claim.
claims_write() {
    local f data
    f=$(claims_dir)/state.json
    data=$(cat)
    jq -e 'type == "object" and has("holders") and has("queue")' <<<"$data" >/dev/null 2>&1 \
        || { printf 'wto: claims ledger update failed; left unchanged\n' >&2; return 1; }
    printf '%s\n' "$data" >"$f.tmp"
    mv -- "$f.tmp" "$f"
}

registry_check() {
    local reg name
    reg=$(claims_dir)/resources
    [[ -s $reg ]] || return 0
    for name in "$@"; do
        grep -Fxq -- "$name" "$reg" || die "claim: unknown resource '$name' (known: $(paste -sd' ' "$reg"))"
    done
}

# JSON array of worktree paths that still exist, read inside the lock so a
# worktree created a moment ago keeps its claim. A failed or empty listing
# would read as "every worktree is gone", so it fails instead.
existing_wts() {
    local rows="" path real exist
    local -a paths=()
    rows=$(worktree_rows) || rows=""
    while IFS=$'\037' read -r path _; do
        [[ -n $path ]] || continue
        resolve_dir real "$path"
        paths+=("$real")
    done <<<"$rows"
    exist=$(jq -n -c '$ARGS.positional' --args "${paths[@]}")
    if [[ $(jq -r 'length > 0' <<<"$exist" 2>/dev/null) != true ]]; then
        printf 'wto: cannot list worktrees; claims left unchanged\n' >&2
        return 1
    fi
    printf '%s\n' "$exist"
}

# JSON array of worktree paths with a live session, plus any paths given.
live_wts() {
    local roster
    roster=$(roster_json fast) || return 1
    jq -c --args '[.[] | select(.session.running == true and .session.state != "exited") | .path]
        + $ARGS.positional | unique' "$@" <<<"$roster"
}

# Drop entries for removed worktrees, then walk the queue in order. A waiter is
# granted when what it still needs is free and no earlier live waiter asked for
# any of it, so a multi-resource request cannot starve. The one exception: an
# earlier waiter that wants something this waiter already holds cannot proceed
# before this one frees it, so its reservation is not honoured (that would
# deadlock both). Waiters without a live session keep their place but are
# skipped and reserve nothing.
# shellcheck disable=SC2016  # jq program, not shell
readonly GRANT_JQ='
    . as $st
    | ($st.holders // {} | with_entries(select(.value.wt as $w | $exist | index($w)))) as $h
    | ($st.queue // [] | map(select(.wt as $w | $exist | index($w)))) as $q
    | reduce $q[] as $e ({holders: $h, queue: [], blocked: [], grants: []};
        . as $acc
        | [$acc.holders | to_entries[] | select(.value.wt == $e.wt) | .key] as $mine
        | ($e.res - $mine) as $need
        | if ($need | length) == 0 then .
        elif ($live | index($e.wt)) == null then .queue += [$e]
        elif ([$need[] | $acc.holders[.] == null] | all)
            and ([$acc.blocked[] | select(.wt != $e.wt and ([.res[] | IN($need[])] | any))
                  | [.res[] | IN($mine[])] | any] | all)
        then .holders += ($need | map({key: ., value: {wt: $e.wt, branch: $e.branch, since: $now,
                 note: $e.note, granted_at: $now, acked_at: null}}) | from_entries)
            | .grants += [{branch: $e.branch, wt: $e.wt, res: $need}]
        else .queue += [$e] | .blocked += [{wt: $e.wt, res: $e.res}]
        end)
    | {state: ($st + {holders: .holders, queue: .queue}), grants: .grants}'

report_grants() {
    jq -r --argjson L "$WTO_LABELS" \
        '.grants[] | "granted \(.res | join(",")) to \($L[.wt] // .branch) — tell that session it is its turn"'
}

claim_take_locked() {
    local wt=$1 label=$2 note=$3 live=$4 exist now st out
    shift 4
    exist=$(existing_wts) || return 1
    now=$(date +%s)
    st=$(claims_read)
    out=$(jq -c --arg wt "$wt" --arg label "$label" --arg note "$note" --argjson now "$now" \
        --argjson live "$live" --argjson exist "$exist" --args '
        ($ARGS.positional | unique) as $res
        | . as $st
        # What this worktree neither holds nor already waits for joins the back
        # of the queue; growing an earlier request would jump the queue.
        | ([$st.holders | to_entries[] | select(.value.wt == $wt) | .key]
           + [$st.queue[]? | select(.wt == $wt) | .res[]]) as $have
        | ($res - $have) as $new
        | if ($new | length) == 0 then .
          else .seq += 1 | .queue += [{id: .seq, wt: $wt, branch: $label, res: $new, note: $note, at: $now}]
          end
        | '"$GRANT_JQ"'
        | .state.holders |= with_entries(if .value.wt == $wt and .value.acked_at == null and .value.granted_at == $now
              then .value.acked_at = $now else . end)
        | . + {mine: ([.state.holders | to_entries[] | select(.value.wt == $wt) | .key]),
               position: ([.state.queue[] | select(.wt as $w | $live | index($w))] | map(.wt) | index($wt))}
        ' "$@" <<<"$st")
    [[ -n $out ]] || return 1
    jq -c '.state' <<<"$out" | claims_write || return 1
    jq -r --args '
        ($ARGS.positional) as $want
        | if (.mine as $m | [$want[] | IN($m[])] | all) then "held: \($want | join(","))"
          else "queued at position \((.position // 0) + 1) for \($want | join(","))"
            + (if (.mine | length) > 0 then "\nnote: still holding \(.mine | join(",")) while waiting; a session waiting for those cannot proceed, so free what you can or take everything in one call" else "" end)
          end' "$@" <<<"$out"
    jq -r --arg wt "$wt" '{grants: [.grants[] | select(.wt != $wt)]}' <<<"$out" | report_grants
    [[ $(jq -r --args '.mine as $m | [$ARGS.positional[] | IN($m[])] | all' "$@" <<<"$out") == true ]] || return 2
}

claim_free_locked() {
    local wt=$1 label=$2 all=$3 force=$4 live=$5 exist now st out
    shift 5
    exist=$(existing_wts) || return 1
    now=$(date +%s)
    st=$(claims_read)
    out=$(jq -c --arg wt "$wt" --arg label "$label" --argjson all "$all" --argjson force "$force" \
        --argjson now "$now" --argjson live "$live" --argjson exist "$exist" --args '
        ($all == 1) as $all | ($force == 1) as $force
        | ($ARGS.positional) as $res
        | (if $all then [.holders | to_entries[] | select(.value.wt == $wt) | .key] else $res end) as $targets
        | . as $st
        | ([$targets[] | select($st.holders[.] != null and $st.holders[.].wt != $wt)]) as $others
        | if ($others | length) > 0 and ($force | not) then {error: "held by another worktree: \($others | join(",")) (use --force)"}
          else
            .log = ((.log // []) + [$others[] | {at: $now, forced_by: $label, res: ., from: $st.holders[.].branch}] | .[-50:])
            | .holders |= with_entries(select(.key as $k | $targets | index($k) | not))
            | (if $all then .queue |= map(select(.wt != $wt)) else . end)
            | '"$GRANT_JQ"'
          end' "$@" <<<"$st")
    [[ -n $out ]] || return 1
    if [[ $(jq -r '.error // empty' <<<"$out") ]]; then
        die "claim free: $(jq -r .error <<<"$out")"
    fi
    jq -c '.state' <<<"$out" | claims_write || return 1
    report_grants <<<"$out"
}

claim_gc_locked() {
    local live=$1 exist now out
    exist=$(existing_wts) || return 1
    now=$(date +%s)
    out=$(claims_read | jq -c --argjson now "$now" --argjson live "$live" --argjson exist "$exist" "$GRANT_JQ")
    [[ -n $out ]] || return 1
    jq -c '.state' <<<"$out" | claims_write || return 1
    report_grants <<<"$out"
}

claim_bump_locked() {
    local wt=$1 name=$2 live=$3 exist now out
    exist=$(existing_wts) || return 1
    now=$(date +%s)
    out=$(claims_read | jq -c --arg w "$wt" --arg n "$name" --argjson now "$now" --argjson live "$live" --argjson exist "$exist" '
        if any(.queue[]?; .wt == $w) | not then {error: "\($n) is not waiting for anything"}
        else .queue = ([.queue[] | select(.wt == $w)] + [.queue[] | select(.wt != $w)]) | '"$GRANT_JQ"'
        end')
    [[ -n $out ]] || return 1
    if [[ $(jq -r '.error // empty' <<<"$out") ]]; then
        die "claim bump: $(jq -r .error <<<"$out")"
    fi
    jq -c '.state' <<<"$out" | claims_write || return 1
    report_grants <<<"$out"
}

claim_ack_locked() {
    local wt=$1 now
    now=$(date +%s)
    claims_read | jq -c --arg wt "$wt" --argjson now "$now" \
        '.holders |= with_entries(if .value.wt == $wt and .value.acked_at == null then .value.acked_at = $now else . end)' \
        | claims_write
}

claims_status() {
    local json=$1 st
    st=$(claims_read)
    if ((json)); then
        jq . <<<"$st"
        return
    fi
    jq -r --argjson L "$WTO_LABELS" '
        (if (.holders | length) == 0 then "no claims held"
         else (.holders | to_entries[] | "\(.key)\theld by \($L[.value.wt] // .value.branch)\t\(if .value.acked_at == null then "granted, not yet acknowledged" else "in use" end)\t\(.value.note // "")") end),
        (.queue | to_entries[] | "\(.value.res | join(","))\twaiting #\(.key + 1): \($L[.value.wt] // .value.branch)\tqueued\t\(.value.note // "")")
    ' <<<"$st" | column -t -s $'\t'
}

cmd_claim() {
    local sub=${1:-status} wt label live note="" all=0 force=0 json=0 timeout=60 deadline rc
    (($#)) && shift
    local -a names=()
    while (($#)); do
        case $1 in
            --note) note=${2:?claim: --note needs text}; shift ;;
            --all) all=1 ;;
            --force) force=1 ;;
            --json) json=1 ;;
            --timeout) timeout=${2:?claim: --timeout needs seconds}; shift ;;
            -h | --help) usage; return ;;
            -*) die "claim: unknown option '$1'" ;;
            *) names+=("$1") ;;
        esac
        shift
    done
    case $sub in
        take | free | check | wait)
            wt=$(self_wt)
            label=$(self_label)
            ;;
        *) wt="" ;;
    esac
    case $sub in
        take | free | bump | gc)
            live=$(live_wts ${wt:+"$wt"}) || die "claim: cannot read the session roster; claims left unchanged"
            ;;
    esac
    case $sub in
        free | bump | gc | status | check) WTO_LABELS=$(labels_json) || WTO_LABELS='{}' ;;
    esac

    case $sub in
        define)
            if ((${#names[@]} == 0)); then
                [[ -s $(claims_dir)/resources ]] && cat -- "$(claims_dir)/resources"
                return 0
            fi
            printf '%s\n' "${names[@]}" | sort -u >"$(claims_dir)/resources"
            ;;
        take)
            ((${#names[@]})) || die "claim take: name at least one resource"
            registry_check "${names[@]}"
            with_lock claim_take_locked "$wt" "$label" "$note" "$live" "${names[@]}"
            ;;
        free)
            ((all || ${#names[@]})) || die "claim free: name resources or pass --all"
            with_lock claim_free_locked "$wt" "$label" "$all" "$force" "$live" "${names[@]}"
            ;;
        check)
            ((${#names[@]})) || die "claim check: name at least one resource"
            rc=$(claims_read | jq -r --arg wt "$wt" --args '
                [$ARGS.positional[] as $r | .holders[$r].wt == $wt] | all' "${names[@]}")
            if [[ $rc == true ]]; then
                with_lock claim_ack_locked "$wt" 2>/dev/null || true
                return 0
            fi
            claims_read | jq -r --arg wt "$wt" --argjson L "$WTO_LABELS" --args '$ARGS.positional[] as $r
                | if .holders[$r] == null then "\($r): free (take it first)"
                  elif .holders[$r].wt != $wt then "\($r): held by \($L[.holders[$r].wt] // .holders[$r].branch)"
                  else empty end' "${names[@]}" >&2
            return 1
            ;;
        wait)
            if [[ $(claims_read | jq -r --arg wt "$wt" 'any(.queue[]?; .wt == $wt)') != true ]]; then
                printf 'not waiting for anything\n'
                return 1
            fi
            claims_read | jq -r --arg wt "$wt" '.queue | to_entries[] | select(.value.wt == $wt)
                | "waiting #\(.key + 1) for \(.value.res | join(","))"'
            deadline=$((SECONDS + timeout))
            while ((SECONDS < deadline)); do
                # Hand over on our own behalf too: a waiter with no agent
                # session is skipped by everyone else's grant pass.
                if live=$(live_wts "$wt" 2>/dev/null); then
                    with_lock claim_gc_locked "$live" >/dev/null 2>&1 || true
                fi
                if [[ $(claims_read | jq -r --arg wt "$wt" 'any(.queue[]?; .wt == $wt)') != true ]]; then
                    with_lock claim_ack_locked "$wt" 2>/dev/null || true
                    printf 'granted\n'
                    return 0
                fi
                sleep 2
            done
            printf 'still waiting\n'
            return 2
            ;;
        status) claims_status "$json" ;;
        bump)
            ((${#names[@]} == 1)) || die "claim bump: name one branch or folder"
            wt=$(resolve_entry "$(roster_json fast)" "${names[0]}" "claim bump" | jq -r .path)
            with_lock claim_bump_locked "$wt" "${names[0]}" "$live"
            ;;
        gc) with_lock claim_gc_locked "$live" ;;
        *) die "claim: unknown subcommand '$sub'" ;;
    esac
}

# ── profile ───────────────────────────────────────────────────────────────────
# The project profile /onboard writes: .agents/profile.md in the repo, or
# profile.md in the project's `dot agent` overlay, which a work project uses
# even when it tracks its own AGENTS.md. Kept out of AGENTS.md so sessions
# load it only when a skill needs it.

profile_path() {
    local top target common overlay
    top=$(self_top)
    if [[ -f $top/.agents/profile.md ]]; then
        printf '%s\n' "$top/.agents/profile.md"
        return 0
    fi
    if [[ -L $top/AGENTS.md ]]; then
        target=$(readlink -f -- "$top/AGENTS.md") || return 1
        [[ -f ${target%/*}/profile.md ]] && { printf '%s\n' "${target%/*}/profile.md"; return 0; }
    fi
    common=$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
    wto_home
    overlay=$WTO_HOME/agent-files/projects/$(basename "$(dirname "$(realpath -- "$common")")")/profile.md
    [[ -f $overlay ]] && { printf '%s\n' "$overlay"; return 0; }
    return 1
}

# A profile still kept as a section of AGENTS.md, from before it had a file.
legacy_profile() {
    local top section
    top=$(self_top)
    [[ -f $top/AGENTS.md ]] || return 1
    section=$(awk '/^## Project profile[[:space:]]*$/ { on = 1; print; next }
        on && /^## / { exit }
        on { print }' "$top/AGENTS.md")
    [[ -n $section ]] || return 1
    printf '%s\n' "$section"
}

cmd_profile() {
    local path
    case ${1:-} in
        --path) profile_path || exit 1 ;;
        '')
            if path=$(profile_path); then
                cat -- "$path"
            elif legacy_profile; then
                printf 'wto: this profile is a section of AGENTS.md; /onboard moves it into its own file\n' >&2
            else
                exit 1
            fi
            ;;
        -h | --help) usage ;;
        *) die "profile: unknown option '$1'" ;;
    esac
}


# ── launch: worktree windows and the agent layout ─────────────────────────────
# wtc, wta, tav and tavk in functions.d are thin wrappers over new, open and
# layout, so agents and people run the same code.

# The dotfiles checkout this script lives in; set on first use by wto_home.
WTO_HOME=""
wto_home() {
    [[ -z $WTO_HOME ]] || return 0
    WTO_HOME=$(readlink -f -- "${BASH_SOURCE[0]}")
    WTO_HOME=${WTO_HOME%/*}
    WTO_HOME=${WTO_HOME%/*}
}
# Holds a new window until its agent pane is respawned; an interactive shell
# here would probe the terminal and leak replies into the agent's input.
readonly PLACEHOLDER='sleep 600'

# Fill AI_TOOL / AI_TOOL_RESUME from ~/.localrc, where `dot ai-tool` writes
# them, for shells that never sourced it.
load_ai_tool() {
    local line value
    if [[ -z ${AI_TOOL:-} || -z ${AI_TOOL_RESUME:-} ]] && [[ -f $HOME/.localrc ]]; then
        while IFS= read -r line; do
            value=${line#*=}
            value=${value#\"}
            value=${value%\"}
            case $line in
                'export AI_TOOL='*) AI_TOOL=${AI_TOOL:-$value} ;;
                'export AI_TOOL_RESUME='*) AI_TOOL_RESUME=${AI_TOOL_RESUME:-$value} ;;
            esac
        done <"$HOME/.localrc"
    fi
    [[ -n ${AI_TOOL:-} && -n ${AI_TOOL_RESUME:-} ]] \
        || die "AI_TOOL / AI_TOOL_RESUME unset; run dot ai-tool"
}

# The harness shortcuts, as .aliases defines them for people. Launches run
# outside an interactive shell, so aliases would not expand there.
tool_command() {
    local first=${1%% *} rest=""
    [[ $1 == *' '* ]] && rest=" ${1#* }"
    case $first in
        cl) first=claude ;;
        cca) first='claude --permission-mode bypassPermissions' ;;
        gr) first='grok --trust' ;;
        gra) first='grok --always-approve --trust' ;;
        oc) first=opencode ;;
        oca) first='opencode --auto' ;;
    esac
    printf '%s%s\n' "$first" "$rest"
}

# Worktree windows launch without permission prompts, or an unattended pane
# would block: oc has no --auto, and cl asks before every tool.
auto_tool() {
    local first=${1%% *} rest=""
    [[ $1 == *' '* ]] && rest=" ${1#* }"
    case $first in
        oc | opencode) first=oca ;;
        cl | claude) first=cca ;;
    esac
    printf '%s%s\n' "$first" "$rest"
}

# The model and effort `new` saved for a worktree, in its own git dir so that
# git worktree remove deletes them.
launch_file() {
    local gitdir
    git_dir_of gitdir "$1" || return 1
    printf '%s/ai-launch\n' "$gitdir"
}

# The saved settings of worktree $2 as model|effort into variable $1; fails
# when there are none.
launch_settings_into() {
    local _ls_gitdir _ls_key _ls_value _ls_model="" _ls_effort=""
    git_dir_of _ls_gitdir "$2" || return 1
    [[ -f $_ls_gitdir/ai-launch ]] || return 1
    while IFS='=' read -r _ls_key _ls_value; do
        case $_ls_key in
            model) _ls_model=$_ls_value ;;
            effort) _ls_effort=$_ls_value ;;
        esac
    done <"$_ls_gitdir/ai-launch"
    printf -v "$1" '%s|%s' "$_ls_model" "$_ls_effort"
}

launch_settings() {
    local saved
    launch_settings_into saved "$1" || return 1
    printf '%s\n' "$saved"
}

# An empty value keeps the saved one.
launch_save() {
    local dir=$1 model=$2 effort=$3 file saved old_model="" old_effort=""
    file=$(launch_file "$dir") || return 1
    if saved=$(launch_settings "$dir"); then
        IFS='|' read -r old_model old_effort <<<"$saved"
    fi
    printf 'model=%s\neffort=%s\n' "${model:-$old_model}" "${effort:-$old_effort}" >"$file"
}

# The model and effort ai/models.yaml gives job $1 for the harness in $AI_TOOL,
# as model|effort, from the table the dotfiles installer merges.
job_settings() {
    local job=$1 file harness
    file=${XDG_STATE_HOME:-$HOME/.local/state}/dotfiles/ai-models.json
    [[ -f $file ]] || die "new: no job table at $file; run dot update"
    jq -e --arg j "$job" 'has($j)' "$file" >/dev/null \
        || die "new: unknown job '$job' (jobs: $(jq -r 'keys | join(", ")' "$file"))"
    case ${AI_TOOL%% *} in
        cl | cca | claude) harness=claude ;;
        gr | gra | grok) harness=grok ;;
        oc | oca | opencode) harness=opencode ;;
        *) die "new: cannot tell the harness of AI_TOOL '$AI_TOOL' for -j" ;;
    esac
    jq -r --arg j "$job" --arg h "$harness" \
        '.[$j][$h] // {} | "\(.model // "")|\(.effort // "")"' "$file"
}

# <project>/<branch>, the name Claude sessions get so peers can address them.
session_name() {
    local dir=$1 common
    common=$(git -C "$dir" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || return 1
    printf '%s/%s\n' "$(basename "$(dirname "$common")")" "$(label_for "$dir")"
}

# The full command line for a harness in dir. With a prompt, it ends in
# "$WTO_PROMPT", which the pane's launcher reads from the prompt file.
build_launch() {
    local tool=$1 dir=$2 with_prompt=$3 expanded bin name saved model="" effort=""
    expanded=$(tool_command "$tool")
    bin=${expanded%% *}
    bin=${bin##*/}
    # Each worktree is a new Grok workspace; without --trust the TUI blocks on
    # "Do you trust this directory?" and an unattended agent never starts.
    if [[ $bin == grok && " $expanded " != *' --trust '* ]]; then
        expanded+=' --trust'
    fi
    if [[ $bin == claude && " $expanded " != *' --name '* && " $expanded " != *' -n '* ]] \
        && name=$(session_name "$dir"); then
        expanded+=" --name $(printf '%q' "$name")"
    fi
    if [[ $bin == claude || $bin == grok ]] && saved=$(launch_settings "$dir"); then
        IFS='|' read -r model effort <<<"$saved"
    fi
    if [[ $bin == claude ]]; then
        [[ -n $model && " $expanded " != *' --model '* ]] && expanded+=" --model $(printf '%q' "$model")"
        [[ -n $effort && " $expanded " != *' --effort '* ]] && expanded+=" --effort $(printf '%q' "$effort")"
    elif [[ $bin == grok ]]; then
        [[ -n $model && " $expanded " != *' --model '* && " $expanded " != *' -m '* ]] \
            && expanded+=" -m $(printf '%q' "$model")"
        [[ -n $effort && " $expanded " != *' --reasoning-effort '* && " $expanded " != *' --effort '* ]] \
            && expanded+=" --reasoning-effort $(printf '%q' "$effort")"
    fi
    if [[ -n $with_prompt ]]; then
        # OpenCode's positional argument is a directory, not a prompt.
        # shellcheck disable=SC2016 # expanded later, in the pane's launcher
        if [[ $bin == opencode ]]; then
            expanded+=' --prompt="$WTO_PROMPT"'
        else
            expanded+=' "$WTO_PROMPT"'
        fi
    fi
    printf '%s\n' "$expanded"
}

# A prompt file the agent pane's launcher reads once and deletes.
prompt_file() {
    local text=$1 file
    file=$(mktemp "${TMPDIR:-/tmp}/wto-prompt.XXXXXX") || die "mktemp failed"
    printf '%s' "$text" >"$file" || {
        rm -f -- "$file"
        die "could not write the prompt file"
    }
    printf '%s\n' "$file"
}

grok_trust_folder() {
    local path=$1 dest="$HOME/.grok/trusted_folders.toml" header
    [[ -n $path ]] || return 0
    path=$(readlink -f -- "$path" 2>/dev/null || printf '%s' "$path")
    [[ -n $path && $path != / && $path != "$HOME" ]] || return 0
    header="[folders.\"${path}\"]"
    mkdir -p "$HOME/.grok"
    if [[ ! -f $dest ]]; then
        : >"$dest"
        chmod 600 "$dest" || true
    fi
    grep -Fq -- "$header" "$dest" 2>/dev/null && return 0
    if [[ -s $dest ]]; then
        [[ -n $(tail -c1 "$dest" 2>/dev/null || true) ]] && printf '\n' >>"$dest"
        printf '\n' >>"$dest"
    fi
    {
        printf '%s\n' "$header"
        printf 'trusted = true\n'
        printf 'decided_at = %s\n' "$(date +%s)"
    } >>"$dest"
    chmod 600 "$dest" 2>/dev/null || true
}

# Pre-accept Claude's trust dialog. Running sessions rewrite ~/.claude.json
# often, so only swap in our copy when the file is unchanged since we read it,
# and try again when it changed.
claude_trust_folder() {
    local dir=$1 cfg="$HOME/.claude.json" before tmp try
    [[ -n $dir && -f $cfg ]] || return 0
    dir=$(readlink -f -- "$dir" 2>/dev/null || printf '%s' "$dir")
    [[ -n $dir && $dir != / && $dir != "$HOME" ]] || return 0
    for try in 1 2 3 4 5; do
        jq -e --arg d "$dir" '.projects[$d].hasTrustDialogAccepted == true' "$cfg" >/dev/null 2>&1 \
            && return 0
        ((try == 1)) || sleep 0.2
        before=$(cksum <"$cfg")
        tmp=$(mktemp "$cfg.XXXXXX") || return 0
        if jq --arg d "$dir" '.projects[$d].hasTrustDialogAccepted = true' "$cfg" >"$tmp" \
            && [[ $(cksum <"$cfg") == "$before" ]]; then
            chmod 600 "$tmp"
            mv -- "$tmp" "$cfg"
        else
            rm -f -- "$tmp"
        fi
    done
    return 0
}

# Grok session to resume for a worktree. grok -c continues the newest session
# for the cwd, empty ones included, which shadows the last real conversation;
# pick the most recently active parent session with a title or real messages.
grok_resume_id() {
    local wt_path=$1 key dir id
    local -a summaries=()
    key=$(jq -nr --arg p "$wt_path" '$p|@uri') || return 1
    dir="${GROK_HOME:-$HOME/.grok}/sessions/$key"
    [[ -d $dir ]] || return 1
    summaries=("$dir"/*/summary.json)
    ((${#summaries[@]} > 0)) || return 1
    id=$(jq -rs '
        map(select(
            (.session_kind // "") != "subagent" and
            (.session_kind // "") != "subagent_resume" and
            (((.generated_title // "") | length) > 0 or ((.num_chat_messages // 0) > 2))
        ))
        | max_by(.last_active_at // .updated_at // "")
        | .info.id // empty
    ' "${summaries[@]}") || return 1
    [[ -n $id ]] || return 1
    printf '%s\n' "$id"
}

# True if the configured harness has a conversation for this path. Claude keeps
# transcripts under ~/.claude/projects/<path, non-alphanumerics as ->/;
# OpenCode has no probe.
has_session_history() {
    local wt_path=$1
    if is_grok "$AI_TOOL"; then
        grok_resume_id "$wt_path" >/dev/null
        return
    fi
    case ${AI_TOOL%% *} in
        cl | cca | claude)
            wt_path=$(readlink -f -- "$wt_path" 2>/dev/null || printf '%s' "$wt_path")
            [[ -n $(find "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects/${wt_path//[^a-zA-Z0-9]/-}" \
                -maxdepth 1 -name '*.jsonl' 2>/dev/null | head -n 1) ]]
            ;;
        *) return 1 ;;
    esac
}

is_grok() {
    case ${1%% *} in gra | grok | gr) return 0 ;; esac
    return 1
}

# The command a worktree window launches: a continued conversation when one
# exists.
window_tool() {
    local wt_path=$1 resume_id cmd
    if is_grok "$AI_TOOL" && resume_id=$(grok_resume_id "$wt_path"); then
        cmd="$AI_TOOL -r $resume_id"
    elif has_session_history "$wt_path"; then
        cmd=$AI_TOOL_RESUME
    else
        cmd=$AI_TOOL
    fi
    auto_tool "$cmd"
}

# Worktrees of a project share a parent dir, so the session takes that dir's
# name, unless this client already sits in the project under another session
# name (opened with `tn`), whose session then gets the new windows.
session_for() {
    local root cur_session cur_path
    root=$(dirname "$1")
    if [[ -n ${TMUX:-} && -n ${TMUX_PANE:-} ]]; then
        cur_session=$(tmux display-message -t "$TMUX_PANE" -p '#{session_name}' 2>/dev/null) || cur_session=""
        cur_path=$(tmux display-message -t "$TMUX_PANE" -p '#{pane_current_path}' 2>/dev/null) || cur_path=""
        if [[ -n $cur_session && ($cur_path == "$root" || $cur_path == "$root"/*) ]]; then
            printf '%s\n' "$cur_session"
            return
        fi
    fi
    basename "$root"
}

# Window id (@N) of a worktree's window: one with a pane tagged for it, else a
# window that older versions named after the branch (fixed name, so automatic
# rename off), which then gets the tag. Found windows follow the live branch.
window_for() {
    local path=$1 branch=$2 session=$3 wid id wname auto
    wid=$(windows_json | jq -r --arg p "$path" '.[$p] // empty')
    if [[ -z $wid && -n $branch ]]; then
        while IFS=$'\t' read -r id wname auto; do
            if [[ $wname == "${branch//\//-}" && $auto == 0 ]]; then
                wid=$id
                break
            fi
        done < <(tmux list-windows -t "=$session" \
            -F "#{window_id}"$'\t'"#{window_name}"$'\t'"#{automatic-rename}" 2>/dev/null)
        [[ -n $wid ]] && tmux set-option -w -t "$wid" @ai_wt "$path" 2>/dev/null
    fi
    [[ -n $wid ]] || return 1
    tmux set-option -wu -t "$wid" automatic-rename 2>/dev/null || true
    tmux set-option -wu -t "$wid" allow-rename 2>/dev/null || true
    printf '%s\n' "$wid"
}

goto_window() {
    local session=$1 wid=${2-}
    if [[ -n ${TMUX:-} ]]; then
        tmux switch-client -t "=$session" 2>/dev/null || true
        [[ -n $wid ]] && tmux select-window -t "$wid" 2>/dev/null
    else
        [[ -n $wid ]] && tmux select-window -t "$wid" 2>/dev/null
        tmux attach -t "=$session"
    fi
    return 0
}

# The size of the client the window will be viewed at, minus the status bar
# rows tmux keeps outside the window. tav's splits are fixed at creation and
# tmux grows windows unevenly, so a window built at the 80x24 default and later
# attached to a taller client loses its proportions.
target_geometry() {
    local x y status lines
    if [[ -n ${TMUX:-} ]]; then
        x=$(tmux display-message -p '#{client_width}' 2>/dev/null) || x=""
        y=$(tmux display-message -p '#{client_height}' 2>/dev/null) || y=""
        status=$(tmux display-message -p '#{status}' 2>/dev/null) || status=""
        case $status in
            off) lines=0 ;;
            '' | *[!0-9]*) lines=1 ;;
            *) lines=$status ;;
        esac
    else
        # Not tput: inside $() with stderr redirected it cannot see the
        # terminal and prints terminfo's 80x24.
        read -r y x < <(stty size 2>/dev/null </dev/tty) || true
        lines=1
    fi
    [[ $x =~ ^[0-9]+$ ]] || x=220
    [[ $y =~ ^[0-9]+$ ]] || y=50
    printf '%s %s\n' "$x" "$((y - lines))"
}

# Run a send-keys later from the tmux server, so it survives this process.
schedule_send() {
    local pane=$1 delay=$2 keys=$3
    tmux run-shell -b "sleep $delay; tmux send-keys -t $pane $(printf '%q' "$keys") C-m"
}

# Grok treats Device Attributes / CPR replies as key input and leaves their
# body in its prompt (`0;2600;1c` from Alacritty, `84;0;0c` from tmux,
# `24;1R`). Clear the prompt only while that fingerprint shows, polling ~10s
# because nvim and LazyGit keep probing after first paint. run-shell -b belongs
# to the tmux server and uses /bin/sh.
schedule_da_scrub() {
    local pane=$1 script
    script=$(
        cat <<EOF
sleep 0.8
i=0
while [ "\$i" -lt 16 ]; do
  if tmux capture-pane -t '${pane}' -p -J 2>/dev/null \
      | tail -n 8 \
      | grep -qE '0;2600;1c|84;0;0c|[0-9]+;[0-9]+([;0-9]*)[cRu]'; then
    tmux send-keys -t '${pane}' C-u
  fi
  i=\$((i + 1))
  sleep 0.5
done
true
EOF
    )
    tmux run-shell -b "$script"
}

# Replace a pane with the agent. It starts under a bare bash after a quiet
# period that drains pending terminal replies, and drops into an interactive
# shell when it exits. Respawning the caller's own pane ends this process, so
# it is always the last step.
respawn_agent() {
    local pane=$1 dir=$2 launch=$3 pf=$4 bin wt_root inner outer drain read_prompt="" mark_exited=""
    bin=${launch%% *}
    bin=${bin##*/}
    case $bin in
        claude | grok | opencode)
            wt_root=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) || wt_root=$dir
            # The window keeps the tag too, so it is found after the agent pane
            # is closed.
            tmux set-option -p -t "$pane" @ai_tool "$bin" \; \
                set-option -p -t "$pane" @ai_wt "$wt_root" \; \
                set-option -w -t "$pane" @ai_wt "$wt_root" \; \
                set-option -p -t "$pane" @ai_state starting \; \
                set-option -p -t "$pane" @ai_state_at "$(date +%s)" \; \
                set-option -p -u -t "$pane" @ai_session 2>/dev/null || true
            # So `wto send` never types a message into the shell left behind.
            mark_exited="; tmux set-option -p -t $pane @ai_state exited \; set-option -p -t $pane @ai_state_at \$(date +%s) 2>/dev/null"
            ;;
    esac
    wto_home
    if [[ $bin == grok && -x $WTO_HOME/bin/tty-filter-da ]]; then
        launch="$WTO_HOME/bin/tty-filter-da $launch"
    fi
    # shellcheck disable=SC2016 # runs in the pane's bash, not here
    drain='
deadline=$((SECONDS + 1))
quiet=0
while (( SECONDS < deadline )); do
  if IFS= read -r -t 0.05 -n 1 _; then
    quiet=0
  else
    quiet=$((quiet + 1))
    (( quiet >= 5 )) && break
  fi
done
'
    [[ -n $pf ]] && read_prompt="WTO_PROMPT=\$(cat -- $(printf '%q' "$pf")); rm -f -- $(printf '%q' "$pf"); "
    inner=". \"\$HOME/.localrc\" 2>/dev/null || true; ${drain}${read_prompt}${launch}"
    outer="bash --noprofile --norc -c $(printf '%q' "$inner")${mark_exited}; exec $(printf '%q' "${SHELL:-bash}") -i"
    # The scrub sends C-u, which would wipe text typed into any other prompt.
    [[ $bin == grok ]] && schedule_da_scrub "$pane"
    tmux respawn-pane -k -t "$pane" -c "$dir" "$outer"
}

# True when an agent harness runs in the pane: laying it out would end it.
pane_runs_agent() {
    local pid
    pid=$(tmux display-message -p -t "$1" '#{pane_pid}' 2>/dev/null) || return 1
    [[ -n $(harness_procs "$pid") ]]
}

# Agent on the left (with a shell below it), nvim with LazyGit on the right,
# and k9s below that with --k9s. The editor waits 2.5s: its terminal probes,
# started alongside the agent, are what leaks replies into the agent's input.
layout() {
    local pane=$1 dir=$2 tool=$3 pf=$4 k9s=$5 launch right
    launch=$(build_launch "$tool" "$dir" "$pf")
    grok_trust_folder "$dir"
    claude_trust_folder "$dir"
    right=$(tmux split-window -d -h -p 65 -t "$pane" -c "$dir" -P -F '#{pane_id}')
    tmux split-window -d -v -p 32 -t "$pane" -c "$dir"
    if [[ -n $k9s ]]; then
        schedule_send "$(tmux split-window -d -v -p 32 -t "$right" -c "$dir" -P -F '#{pane_id}')" 2.5 k9s
    fi
    tmux select-pane -t "$pane"
    schedule_send "$right" 2.5 'nvim . -c "lua vim.schedule(function() Snacks.lazygit() end)"'
    respawn_agent "$pane" "$dir" "$launch" "$pf"
}

# Create one worktree's window and start its layout, unless it has one. Prints
# what it did and leaves the window id in WTO_WINDOW. The prompt file is
# consumed either way.
ensure_window() {
    local wt_path=$1 pf=$2 branch label session tool x y pane wid
    branch=$(git -C "$wt_path" symbolic-ref -q --short HEAD 2>/dev/null) || branch=""
    label=${branch:-${wt_path##*/}}
    session=$(session_for "$wt_path")
    if wid=$(window_for "$wt_path" "$branch" "$session"); then
        [[ -n $pf ]] && rm -f -- "$pf"
        WTO_WINDOW=$wid
        printf '  skip    %s:%s (already has a window)\n' "$session" "$label"
        return 0
    fi
    tool=$(window_tool "$wt_path")
    read -r x y < <(target_geometry)
    if ! tmux has-session -t "=$session" 2>/dev/null; then
        pane=$(tmux new-session -d -s "$session" -c "$wt_path" -x "$x" -y "$y" \
            -P -F '#{pane_id}' "$PLACEHOLDER")
    else
        # The trailing colon makes this a session target even when a window
        # shares the session's name. -d keeps the client where it is.
        pane=$(tmux new-window -d -t "=$session:" -c "$wt_path" -P -F '#{pane_id}' "$PLACEHOLDER")
        # Size it for its client before the splits; resize-window sets the
        # window's own window-size to manual, which would pin it at this size.
        tmux resize-window -t "$pane" -x "$x" -y "$y" 2>/dev/null || true
        tmux set-option -w -u -t "$pane" window-size 2>/dev/null || true
    fi
    tmux set-option -w -t "$pane" @ai_wt "$wt_path"
    WTO_WINDOW=$(tmux display-message -p -t "$pane" '#{window_id}')
    layout "$pane" "$wt_path" "$tool" "$pf" ""
    printf '  create  %s:%s  (%s)\n' "$session" "$label" "$tool"
}

goto_or_report() {
    local wt_path=$1 switch=$2 session
    session=$(session_for "$wt_path")
    if ((switch)); then
        goto_window "$session" "${WTO_WINDOW-}"
    else
        printf '  ready   %s:%s  (staying put)\n' "$session" "$(label_for "$wt_path")"
    fi
}

optval() {
    (($1 >= 2)) || die "$2 needs a value"
}

# -p text or -f file, into a prompt file for the launcher (empty: none).
prompt_arg() {
    local text=$1 file=$2
    if [[ -n $file ]]; then
        [[ -f $file ]] || die "prompt file not found: $file"
        text=$(cat -- "$file"; printf x)
        text=${text%x}
    fi
    [[ -n $text ]] && prompt_file "$text"
    return 0
}

readonly CODENAME_ADJ='amber bold brisk calm clever crisp dapper eager fancy gentle glad golden hardy
humble jolly keen kind lively lucky mellow merry misty nimble noble plucky polite proud quick quiet
rapid rosy rustic sandy shiny silent sleek snappy sober solid spry steady sunny swift tidy vivid warm
witty zesty'
readonly CODENAME_NOUN='acorn anchor badger basil beacon bison canyon cedar cobalt comet coral crane
delta dune ember falcon fern finch fjord garnet gecko glacier harbor hazel heron island jasper kestrel
lagoon lantern maple meadow mesa orchid otter pebble pine quartz raven reef river sparrow summit tundra
walnut willow yarrow zephyr'

# A name no folder, branch or saved conversation uses: a recycled name would
# resume an unrelated conversation in the new folder.
codename_free() {
    local root=$1 name=$2 path key
    path=$root/$name
    [[ ! -e $path ]] || return 1
    ! git show-ref --verify --quiet "refs/heads/$name" || return 1
    [[ ! -e ${CLAUDE_CONFIG_DIR:-$HOME/.claude}/projects/${path//[^a-zA-Z0-9]/-} ]] || return 1
    key=$(jq -nr --arg p "$path" '$p|@uri') || return 1
    [[ ! -e ${GROK_HOME:-$HOME/.grok}/sessions/$key ]]
}

# Create a free codename folder under root and print its path. The mkdir is
# the reservation, so runs in parallel never take the same name.
reserve_folder() {
    local root=$1 try name
    local -a adj noun
    read -r -d '' -a adj <<<"${WTO_CODENAME_ADJ:-$CODENAME_ADJ}" || true
    read -r -d '' -a noun <<<"${WTO_CODENAME_NOUN:-$CODENAME_NOUN}" || true
    ((${#adj[@]} && ${#noun[@]})) || return 1
    for ((try = 0; try < 60; try++)); do
        name=${adj[RANDOM % ${#adj[@]}]}-${noun[RANDOM % ${#noun[@]}]}
        ((try < 50)) || name+=-$(printf '%04x' "$RANDOM")
        if codename_free "$root" "$name" && mkdir -- "$root/$name" 2>/dev/null; then
            printf '%s\n' "$root/$name"
            return 0
        fi
    done
    return 1
}

# The worktree that has branch $1 checked out, if any.
checked_out_in() {
    local path branch
    while IFS=$'\037' read -r path _ branch _; do
        if [[ $branch == "$1" ]]; then
            realpath -e -- "$path" 2>/dev/null || printf '%s\n' "$path"
            return 0
        fi
    done < <(worktree_rows)
    return 1
}

add_worktree() {
    local dir=$1 branch=$2 base=$3 start=$4 l o
    if [[ -z $branch ]]; then
        git worktree add --quiet --detach "$dir" "$start"
        return
    fi
    if git show-ref --verify --quiet "refs/heads/$branch"; then
        [[ -n $base ]] && warn "$branch already exists; ignoring base $base"
        l=$(git rev-parse "refs/heads/$branch")
        if o=$(git rev-parse -q --verify "refs/remotes/origin/$branch^{commit}" 2>/dev/null) \
            && [[ $l != "$o" ]] && git merge-base --is-ancestor "$l" "$o"; then
            git fetch --quiet . "refs/remotes/origin/$branch:refs/heads/$branch" \
                || warn "could not fast-forward $branch to origin/$branch"
        fi
        git worktree add --quiet "$dir" "$branch"
    elif git show-ref --verify --quiet "refs/remotes/origin/$branch"; then
        [[ -n $base ]] && warn "origin/$branch exists; ignoring base $base"
        git worktree add --quiet --track -b "$branch" "$dir" "origin/$branch"
    else
        git worktree add --quiet --no-track -b "$branch" "$dir" "${base:-$start}"
    fi
}

cmd_new() {
    local branch="" base="" text="" file="" model="" effort="" job="" switch=0 pf wt_path
    local job_model job_effort settings root default start other
    local name_re='^[A-Za-z0-9._:@/-]+(\[[A-Za-z0-9]+\])?$'
    while (($#)); do
        case $1 in
            -p | --prompt) optval $# "$1"; text=${2-}; shift ;;
            -f | --prompt-file) optval $# "$1"; file=${2-}; shift ;;
            -m | --model) optval $# "$1"; model=${2-}; shift ;;
            -e | --effort) optval $# "$1"; effort=${2-}; shift ;;
            -j | --job) optval $# "$1"; job=${2-}; shift ;;
            -n | --no-switch) switch=0 ;;
            --switch) switch=1 ;;
            -h | --help) usage; return ;;
            -*) die "new: unknown option '$1'" ;;
            *)
                if [[ -z $branch ]]; then branch=$1
                elif [[ -z $base ]]; then base=$1
                else die "new: too many arguments"
                fi
                ;;
        esac
        shift
    done
    load_ai_tool
    if [[ -n $job ]]; then
        settings=$(job_settings "$job") || exit 1
        IFS='|' read -r job_model job_effort <<<"$settings"
        model=${model:-$job_model}
        effort=${effort:-$job_effort}
    fi
    if [[ -n $model && ! $model =~ $name_re ]] || [[ -n $effort && ! $effort =~ ^[a-z]+$ ]]; then
        die "new: bad --model or --effort value"
    fi
    if [[ -n $branch ]]; then
        git check-ref-format --branch "$branch" >/dev/null 2>&1 || die "new: '$branch' is not a valid branch name"
    fi
    is_bare_project || die "new: needs a bare project (<project>/.git, worktrees beside it); this repository has its own checkout"
    root=$(project_root)

    fetch_origin
    default=$(default_branch) || die "new: cannot tell the default branch (git remote set-head origin --auto)"
    start=$(sync_default "$default")
    if [[ -n $job && $branch == "$default" ]]; then
        die "new: an agent spawn works on its own branch, not $default"
    fi

    if [[ -n $branch ]] && other=$(checked_out_in "$branch"); then
        [[ -n $base ]] && warn "$branch already exists; ignoring base $base"
        printf 'wto: %s is checked out in %s; opening that\n' "$branch" "$other" >&2
        pf=$(prompt_arg "$text" "$file")
        ensure_window "$other" "$pf"
        goto_or_report "$other" "$switch"
        return
    fi

    wt_path=$(reserve_folder "$root") || die "new: no free folder name under $root"
    if ! add_worktree "$wt_path" "$branch" "$base" "$start"; then
        rmdir -- "$wt_path" 2>/dev/null || true
        die "new: could not create the worktree"
    fi

    if [[ -n $model || -n $effort ]]; then
        case ${AI_TOOL%% *} in
            oc | oca | opencode)
                warn "OpenCode takes no per-session model or effort; it starts on its configured default"
                ;;
            *) launch_save "$wt_path" "$model" "$effort" || die "new: could not save model/effort in $wt_path" ;;
        esac
    fi
    if command -v dot >/dev/null 2>&1; then
        (cd -- "$wt_path" && dot agent link >/dev/null) \
            || warn "dot agent link failed in $wt_path; the session starts without the project's agent files"
    fi
    pf=$(prompt_arg "$text" "$file")
    ensure_window "$wt_path" "$pf"
    goto_or_report "$wt_path" "$switch"
}

cmd_open() {
    local name="" text="" file="" switch=0 all=0 roster count pf wt_path
    while (($#)); do
        case $1 in
            -p | --prompt) optval $# "$1"; text=${2-}; shift ;;
            -f | --prompt-file) optval $# "$1"; file=${2-}; shift ;;
            --switch) switch=1 ;;
            -n | --no-switch) switch=0 ;;
            --all) all=1 ;;
            -h | --help) usage; return ;;
            --) shift; [[ -z $name && $# -gt 0 ]] && name=$1 ;;
            -*) die "open: unknown option '$1'" ;;
            *) [[ -z $name ]] && name=$1 ;;
        esac
        (($#)) && shift
    done
    load_ai_tool
    roster=$(roster_json fast)
    count=$(jq length <<<"$roster")
    ((count > 0)) || die "open: this project has no worktrees (wtc starts one)"
    if ((all)); then
        open_all "$roster" "$switch"
        return
    fi
    if [[ -n $name ]]; then
        wt_path=$(resolve_entry "$roster" "$name" open | jq -r .path)
    elif ((count == 1)); then
        wt_path=$(jq -r '.[0].path' <<<"$roster")
    elif [[ -t 0 && -t 1 ]] && command -v fzf >/dev/null 2>&1; then
        wt_path=$(jq -r 'sort_by([(.branch // "~"), .name]) | .[]
                | [(.branch // "(no branch)"), .name, .path] | @tsv' <<<"$roster" \
            | fzf --prompt="Worktree: " --height=40% --reverse --delimiter=$'\t' --with-nth=1,2 \
            | cut -f3) || return 0
        [[ -n $wt_path ]] || return 0
    else
        die "open: name the branch or folder (or install fzf for a picker)"
    fi
    pf=$(prompt_arg "$text" "$file")
    ensure_window "$wt_path" "$pf"
    goto_or_report "$wt_path" "$switch"
}

open_all() {
    local roster=$1 switch=$2 path first="" first_path=""
    while IFS= read -r path; do
        ensure_window "$path" ""
        if [[ -z $first ]]; then
            first=$WTO_WINDOW
            first_path=$path
        fi
    done < <(jq -r 'sort_by([(.branch // "~"), .name]) | .[].path' <<<"$roster")
    if ((switch)) && [[ -n $first_path ]]; then
        goto_window "$(session_for "$first_path")" "$first"
    fi
}

cmd_layout() {
    local tool="" text="" file="" k9s="" pf dir
    while (($#)); do
        case $1 in
            -t | --tool) optval $# "$1"; tool=${2-}; shift ;;
            -f | --prompt-file) optval $# "$1"; file=${2-}; shift ;;
            -p | --prompt) optval $# "$1"; text=${2-}; shift ;;
            --k9s) k9s=1 ;;
            -h | --help) usage; return ;;
            --) shift; break ;;
            -*) die "layout: unknown option '$1'" ;;
            *) break ;;
        esac
        shift
    done
    (($#)) && text="$*"
    [[ -n ${TMUX:-} && -n ${TMUX_PANE:-} ]] || die "layout: run it inside tmux"
    pane_runs_agent "$TMUX_PANE" && die "layout: an agent runs in this pane; laying it out would end it"
    if [[ -z $tool ]]; then
        tool=${AI_TOOL:-}
        [[ -n $tool ]] || { load_ai_tool; tool=$AI_TOOL; }
    fi
    dir=$PWD
    pf=$(prompt_arg "$text" "$file")
    layout "$TMUX_PANE" "$dir" "$tool" "$pf" "$k9s"
}

# ── close ─────────────────────────────────────────────────────────────────────

cmd_close() {
    local name=${1:-} roster entry path branch label head default reason="" target marker
    local status locked=0 since live common tag wid own_window="" deleted=""
    local -a windows=()
    [[ -n $name && $name != -* ]] || die "close: name the branch or folder to close"
    roster=$(roster_json)
    entry=$(resolve_entry "$roster" "$name" close)
    path=$(jq -r .path <<<"$entry")
    branch=$(jq -r '.branch // ""' <<<"$entry")
    label=${branch:-${path##*/}}
    [[ -d $path ]] || die "close: $path is gone; git worktree prune clears its entry"
    [[ $(self_top) != "$path" ]] || die "close: run it from another worktree, not the one being closed"
    marker=$(state_dir)/orchestrator.json
    if marker_valid "$marker" && [[ $MARKER_PATH == "$path" ]]; then
        die "close: $label is the orchestrator's worktree"
    fi
    while IFS=$'\037' read -r tag _ _ wid _; do
        [[ $(realpath -e -- "$tag" 2>/dev/null || printf '%s' "$tag") == "$path" && $wid == 1 ]] && locked=1
    done < <(worktree_rows)
    ((!locked)) || die "close: $label's worktree is locked (git worktree unlock)"
    status=$(git -C "$path" status --porcelain) || die "close: cannot read the status of $path"
    [[ -z $status ]] || die "close: $label has uncommitted changes"
    [[ $(jq -r '.operation // ""' <<<"$entry") == "" ]] \
        || die "close: $label is in the middle of a $(jq -r .operation <<<"$entry")"

    default=$(default_branch) || die "close: cannot tell the default branch"
    head=$(git -C "$path" rev-parse HEAD)
    for target in "refs/heads/$default" "refs/remotes/origin/$default"; do
        if reason=$(integrated_reason "$head" "$target"); then
            break
        fi
        reason=""
    done
    [[ -n $reason ]] || die "close: $label is not merged into $default or origin/$default"
    if [[ -z $branch && -n $(git rev-list -n 1 "$head" --not --branches --remotes) ]]; then
        die "close: $label has commits on no branch; name one there (git switch -c <branch>) first"
    fi

    if [[ -n ${TMUX_PANE-} ]]; then
        own_window=$(tmux display-message -p -t "$TMUX_PANE" '#{window_id}' 2>/dev/null) || own_window=""
    fi
    if tmux info >/dev/null 2>&1; then
        while IFS=$'\t' read -r tag wid; do
            [[ $tag == "$path" ]] && windows+=("$wid")
        done < <(tmux list-panes -a -F '#{@ai_wt}'$'\t''#{window_id}')
        wid=$(jq -r '.session.pane // empty' <<<"$entry")
        [[ -n $wid ]] && windows+=("$(tmux display-message -p -t "$wid" '#{window_id}' 2>/dev/null || true)")
    fi
    for wid in "${windows[@]}"; do
        [[ -n $wid && $wid == "$own_window" ]] && die "close: this window belongs to $label; run it from another window"
    done
    for wid in $(printf '%s\n' "${windows[@]}" | sort -u); do
        [[ -n $wid ]] && tmux kill-window -t "$wid" 2>/dev/null
    done

    since=$(date +%s)
    common=$(common_dir)
    git --git-dir="$common" worktree remove "$path" \
        || die "close: git worktree remove failed; the window is closed but the worktree and its claims remain (wto open $label)"
    if [[ -n $branch && $branch != "$default" ]]; then
        tag=$(git rev-parse --short "refs/heads/$branch")
        git branch -D --quiet "$branch" && deleted=" (deleted branch $branch, was $tag)"
    fi
    if ! live=$(live_wts) || ! with_lock claim_gc_locked "$live" >/dev/null; then
        warn "claims of $label not handed over yet; run wto claim gc"
    fi
    WTO_LABELS=$(labels_json) || WTO_LABELS='{}'
    claims_read | jq -r --argjson since "$since" --argjson L "$WTO_LABELS" '
        [.holders | to_entries[] | select((.value.granted_at // 0) >= $since and .value.acked_at == null)]
        | group_by(.value.wt)[]
        | "granted \(map(.key) | join(",")) to \($L[.[0].value.wt] // .[0].value.branch) — tell that session it is its turn"'
    printf 'closed %s%s\n' "$label" "$deleted"
}

main() {
    local cmd=${1:-}
    (($#)) && shift
    case $cmd in
        ls) require jq git; require_git; cmd_ls "$@" ;;
        default) require git; cmd_default "$@" ;;
        here) require jq git tmux; cmd_here "$@" ;;
        dir) require git; state_dir ;;
        profile) require git; cmd_profile "$@" ;;
        send) require jq git tmux; cmd_send "$@" ;;
        header) require jq git; cmd_header "$@" ;;
        claim) require jq git; cmd_claim "$@" ;;
        close) require jq git tmux; require_git; cmd_close "$@" ;;
        new) require jq git tmux; cmd_new "$@" ;;
        open) require jq git tmux; cmd_open "$@" ;;
        layout) require jq git tmux; cmd_layout "$@" ;;
        '' | -h | --help | help) usage ;;
        *) die "unknown command '$cmd' (see wto --help)" ;;
    esac
}

# One line, so bash has read the exit before main runs: a long run (an attach, a
# claim wait) can outlive an edit to this file, and bash reads scripts as it goes.
main "$@"; exit
