#!/usr/bin/env python3
"""Drop terminal DA/CPR replies so a TUI never sees them as keystrokes.

Grok's CSI parser eats ESC/[/> and types the body (Alacritty `0;2600;1c`,
tmux `84;0;0c`). Those keystrokes also dismiss the welcome card. Run the
TUI as: tty-filter-da grok --always-approve
"""
from __future__ import annotations

import errno
import fcntl
import os
import pty
import re
import select
import signal
import sys
import termios
import tty

_CSI_FINAL = range(0x40, 0x7F)
_NUM_SEMI = re.compile(rb"[0-9]+(;[0-9]+)*")


def is_probe_csi(seq: bytes) -> bool:
    """True for Device Attributes / cursor-position reports we must drop."""
    if len(seq) < 3 or seq[0] != 0x1B or seq[1] != ord("["):
        return False
    body, final = seq[2:-1], seq[-1]
    if final == ord("c") and (body.startswith(b">") or body.startswith(b"?")):
        return True
    if final == ord("c") and _NUM_SEMI.fullmatch(body):
        return True
    if final == ord("R") and _NUM_SEMI.fullmatch(body):
        return True
    return False


class InboundFilter:
    """Byte-wise CSI filter. Lone ESC is held until the next byte or flush()."""

    def __init__(self) -> None:
        self._buf = bytearray()
        self._state = "normal"

    def push(self, data: bytes) -> bytes:
        out = bytearray()
        for byte in data:
            out.extend(self._feed(byte))
        return bytes(out)

    def flush(self) -> bytes:
        if self._state == "esc" and self._buf == b"\x1b":
            self._reset()
            return b"\x1b"
        return b""

    def _reset(self) -> None:
        self._buf.clear()
        self._state = "normal"

    def _feed(self, byte: int) -> bytes:
        if self._state == "normal":
            if byte == 0x1B:
                self._buf = bytearray(b"\x1b")
                self._state = "esc"
                return b""
            return bytes([byte])

        if self._state == "esc":
            self._buf.append(byte)
            if byte == ord("["):
                self._state = "csi"
                return b""
            out = bytes(self._buf)
            self._reset()
            return out

        self._buf.append(byte)
        if byte not in _CSI_FINAL:
            if len(self._buf) > 64:
                out = bytes(self._buf)
                self._reset()
                return out
            return b""
        seq = bytes(self._buf)
        self._reset()
        if is_probe_csi(seq):
            return b""
        return seq


def _self_test() -> int:
    cases: list[tuple[bytes, bytes]] = [
        (b"hello", b"hello"),
        (b"\x1b[>0;2600;1c", b""),
        (b"\x1b[>0;2600;1c\x1b[>0;2600;1c", b""),
        (b"\x1b[>84;0;0c", b""),
        (b"\x1b[?1;2c", b""),
        (b"\x1b[24;1R", b""),
        (b"\x1b[A", b"\x1b[A"),
        (b"abc\x1b[>0;2600;1cdef", b"abcdef"),
        (b"\x1bX", b"\x1bX"),
    ]
    failed = 0
    for raw, want in cases:
        got = InboundFilter().push(raw)
        if got != want:
            print(f"FAIL {raw!r}: got {got!r} want {want!r}", file=sys.stderr)
            failed += 1
    held = InboundFilter()
    if held.push(b"\x1b") != b"":
        print("FAIL: lone ESC should be held", file=sys.stderr)
        failed += 1
    if held.flush() != b"\x1b":
        print("FAIL: flush should emit held ESC", file=sys.stderr)
        failed += 1
    if failed:
        print(f"{failed} test(s) failed", file=sys.stderr)
        return 1
    print("ok")
    return 0


def _copy_winsize(src_fd: int, dst_fd: int) -> None:
    packed = fcntl.ioctl(src_fd, termios.TIOCGWINSZ, b"\x00" * 8)
    fcntl.ioctl(dst_fd, termios.TIOCSWINSZ, packed)


def _proxy(argv: list[str]) -> int:
    pid, master = pty.fork()
    if pid == 0:
        os.execvp(argv[0], argv)
        os._exit(127)

    stdin = sys.stdin.fileno()
    stdout = sys.stdout.fileno()
    orig = termios.tcgetattr(stdin)
    filt = InboundFilter()

    def _on_winch(_signum: int, _frame: object) -> None:
        try:
            _copy_winsize(stdin, master)
            os.kill(pid, signal.SIGWINCH)
        except OSError:
            pass

    try:
        tty.setraw(stdin)
        _copy_winsize(stdin, master)
        signal.signal(signal.SIGWINCH, _on_winch)
        while True:
            try:
                readable, _, _ = select.select([stdin, master], [], [], 0.03)
            except InterruptedError:
                continue
            if not readable:
                leftover = filt.flush()
                if leftover:
                    os.write(master, leftover)
                continue
            if stdin in readable:
                try:
                    chunk = os.read(stdin, 4096)
                except OSError as exc:
                    if exc.errno == errno.EIO:
                        break
                    raise
                if not chunk:
                    break
                filtered = filt.push(chunk)
                if filtered:
                    os.write(master, filtered)
            if master in readable:
                try:
                    chunk = os.read(master, 4096)
                except OSError as exc:
                    if exc.errno == errno.EIO:
                        break
                    raise
                if not chunk:
                    break
                os.write(stdout, chunk)
    finally:
        termios.tcsetattr(stdin, termios.TCSADRAIN, orig)
        os.close(master)

    _pid, status = os.waitpid(pid, 0)
    if os.WIFEXITED(status):
        return os.WEXITSTATUS(status)
    if os.WIFSIGNALED(status):
        return 128 + os.WTERMSIG(status)
    return 1


def main() -> int:
    if len(sys.argv) == 2 and sys.argv[1] == "--self-test":
        return _self_test()
    if len(sys.argv) < 2:
        print(f"Usage: {sys.argv[0]} <command> [args...]", file=sys.stderr)
        return 2
    return _proxy(sys.argv[1:])


if __name__ == "__main__":
    raise SystemExit(main())
