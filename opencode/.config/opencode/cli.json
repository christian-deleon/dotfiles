{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system"
  },
  "diffs": {
    "wrap": "word",
    "view": "unified"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "show"
  },
  "tabs": {
    "mode": "off"
  },
  "animations": true,
  "keybinds": {
    "session.background": "<leader>z"
  }
}
