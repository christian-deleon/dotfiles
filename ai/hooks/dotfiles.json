{
  "hooks": {
    "Stop": [
      { "hooks": [{ "type": "command", "command": "stop_notify.sh", "timeout": 10 }] }
    ],
    "Notification": [
      {
        "matcher": "permission_prompt",
        "hooks": [{ "type": "command", "command": "notification_notify.sh" }]
      }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "user_prompt_submit_clear.sh" }] }
    ]
  }
}
