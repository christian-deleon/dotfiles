# Machine-local profile selection — written by install.sh / dot profile use.
# Each machine picks its own profile; this file is not shared across machines.
.active-profile

# Python bytecode from ai/scripts helpers
__pycache__/
*.py[cod]

# Omarchy upgrade residue — generated next to live configs, never source
**/*omarchy-upgrade-to-quattro*
omarchy/.config/omarchy/current/
